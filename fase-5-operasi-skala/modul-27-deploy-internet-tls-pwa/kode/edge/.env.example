# edge/.env.example - setelan Docker Compose GERBANG (Raspberry Pi) Rumah Pintar Mini (Modul 26-27), untuk compose.edge.yml.
# Di Pi, dari folder edge: cp .env.example .env, isi baris yang kosong, lalu chmod 600 .env. edge/.env tidak ikut Git.

# Nama berkas Compose. Dengan baris ini, "docker compose up -d" di folder edge sudah cukup (tanpa -f compose.edge.yml).
COMPOSE_FILE=compose.edge.yml

# Alamat broker PUSAT untuk jembatan RUMAH (address pusat:... di jembatan/pusat.conf). Isi sesuai tempat pusatmu:
#   pusat di laptop (Modul 26, Kit B) : IP laptop, misalnya 192.168.1.10 (pesan alamat tetap di router, seperti mode HP
#                                       Modul 23: kalau IP laptop berganti, jembatan putus)
#   pusat di Pi yang sama (Modul 27, jalur gratis) atau gerbang dicoba di laptop pusat: host-gateway (= mesin ini sendiri)
#   pusat di VPS (Modul 27, jalur utama): biarkan kosong. Jembatan TLS memakai nama domain broker (mqtt.namaanda.my.id)
#                                       yang ditulis langsung di jembatan/pusat.conf, bukan alamat di sini.
# Kosong = host-gateway.
ALAMAT_PUSAT=

# Loket broker gerbang. Di Pi: 1883 (firmware Node 1 memakai 1883). Gerbang dicoba di laptop yang sama dengan
# compose.cloud.yml (Modul 26): 1884, karena 1883 sudah dipakai broker pusat.
PORT_GERBANG=1883

# Node-RED dalam kontainer (profil "nodered", opsional; Modul 26 tetap memakai Node-RED systemd): loket editor.
PORT_NODERED=1880

# Profil yang ikut menyala dengan "docker compose up -d". Kosong = hanya broker gerbang.
# COMPOSE_PROFILES=nodered

# Modul 27: TUNNEL_TOKEN (Cloudflare Tunnel, jalur gratis) TIDAK lagi di sini: tulis di .env akar proyek (compose.cloud.yml).
