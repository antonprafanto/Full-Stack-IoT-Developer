-# lewat jembatan dengan akun jembatan-pi; simulator alat/ lewat loket 1883 laptop. Jalur di bawah = jalur DI DALAM kontainer.
+# Dipakai di laptop (Modul 26) dan di Pi jalur gratis (Modul 27): satu pintu polos 1883 untuk jaringan rumah. Di VPS
+# (Modul 27) dipakai pusat-internet.conf: isinya sama + pintu TLS 8883 (KONF_PUSAT di .env memilih salah satunya).
+# Backend masuk lewat nama layanan mosquitto:1883; gerbang Pi masuk lewat jembatan dengan akun jembatan-pi; simulator alat/
+# lewat loket 1883. Jalur di bawah = jalur DI DALAM kontainer.
 # Sesudah mengubah berkas ini atau acl-broker: docker compose restart mosquitto (restart, bukan reload).
 listener 1883
 # tanpa nama pengguna dan sandi yang terdaftar, tidak boleh masuk (Modul 21)
@@ -9,7 +11,8 @@ allow_anonymous false
 # mosquitto setiap kali menyala, jadi tanpa urusan pemilik berkas di laptop)
 password_file /mosquitto/data/sandi-broker
 acl_file /mosquitto/config/acl-broker
-# nama klien selalu = nama pengguna: tidak ada yang bisa menyamar atau menendang klien lain
+# nama klien selalu = nama pengguna: tidak ada yang bisa menyamar atau menendang klien lain. Opsi ini berlaku PER PINTU
+# (hanya untuk listener di atasnya): pintu baru, misalnya 8883 di pusat-internet.conf, harus menulisnya lagi.
 use_username_as_clientid true
 # pesan retained (status perangkat, config dari backend) dan sesi disimpan di lemari: tidak hilang saat kontainer dibuat ulang
 persistence true
