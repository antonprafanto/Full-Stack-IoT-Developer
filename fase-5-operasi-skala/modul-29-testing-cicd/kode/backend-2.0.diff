@@ -0,0 +1,104 @@
+// app.ts - merakit server Fastify Rumah Pintar Mini TANPA menyalakannya (Modul 29). Isinya pindahan apa adanya dari server.ts
+// (Modul 19-28): pencatat log, satu baris log per permintaan, pemeriksa skema Zod, pengaman API (Modul 20), dokumentasi
+// /docs, dan 8 kelompok rute.
+// Kenapa dipisah? Tes integrasi (src/integrasi/) memanggil buatApp() lalu mengetuk rutenya lewat app.inject() dengan database
+// uji SUNGGUHAN. Jadi yang diuji adalah rakitan YANG SAMA dengan produksi, bukan rakitan tiruan buatan tes: rute yang lupa
+// didaftarkan ikut ketahuan (contoh: tanpa ruteKlaim, tiga tes klaim merah dengan 404), begitu juga satpam login yang hilang
+// (GET /devices tanpa login harus 401). server.ts tinggal menyalakan sisanya (database, MQTT, Telegram, jadwal, Socket.IO)
+// dan mendengar di loketnya.
+import Fastify, { LogController } from "fastify";
+import type { FastifyInstance } from "fastify";
+import swagger from "@fastify/swagger";
+import swaggerUi from "@fastify/swagger-ui";
+import { jsonSchemaTransform, serializerCompiler, validatorCompiler } from "fastify-type-provider-zod";
+import { env } from "./config/env.ts";
+import { VERSI_SERVER } from "./config/versi-server.ts";
+import { pasangKeamanan } from "./auth/keamanan.ts";
+import { ruteAuth } from "./routes/auth.ts";
+import { ruteKesehatan } from "./routes/kesehatan.ts";
+import { rutePerangkat } from "./routes/perangkat.ts";
+import { ruteAturan } from "./routes/aturan.ts";
+import { ruteLaporan } from "./routes/laporan.ts";
+import { ruteFirmware } from "./routes/firmware.ts";
+import { ruteArmada } from "./routes/armada.ts";
+import { ruteKlaim } from "./routes/klaim.ts";
+import { pakaiLog, perluDicatat } from "./services/log.ts";
+
+export interface OpsiApp {
+  // "berwarna" (bawaan, server.ts) = log berwarna pino-pretty seperti sejak Modul 19.
+  // "galat-saja" (tes integrasi) = hanya galat yang ditulis, satu baris JSON tanpa warna: keluaran Vitest tetap bersih, tetapi
+  // alasan jawaban 503 (misalnya kueri SQL yang ditolak database) tetap terbaca saat tes merah.
+  log?: "berwarna" | "galat-saja";
+}
+
+export async function buatApp(opsi: OpsiApp = {}): Promise<FastifyInstance> {
+  const app = Fastify({
+    logger: opsi.log === "galat-saja"
+      ? { level: "error" }
+      : { transport: { target: "pino-pretty", options: { translateTime: "SYS:HH:MM:ss", ignore: "pid,hostname,reqId" } } },
+    logController: new LogController({ disableRequestLogging: true }), // log bawaan per permintaan terlalu panjang...
+    // Modul 27: header X-Forwarded-For/-Proto dari Caddy hanya dipercaya bila datang dari penerus di TRUST_PROXY (di
+    // compose.cloud.yml: uniquelocal = lorong Docker). Kosong (mode kembang) = header itu diabaikan, seperti v1.3.
+    trustProxy: env.TRUST_PROXY,
+  });
+  pakaiLog(app.log); // Modul 19: layanan lain (perintah, aturan, jadwal, Telegram) menulis ke log yang sama
+  app.addHook("onResponse", async (req, reply) => {
+    // ...jadi diganti satu baris per permintaan (hook = "middleware" Fastify). Hanya metode, alamat, dan kode jawaban:
+    // isi permintaan (sandi!) dan cookie (token!) tidak pernah ditulis ke log. Modul 26: ketukan /health yang berhasil
+    // (healthcheck Docker setiap 15 detik) tidak dicatat, supaya log tidak penuh baris yang sama.
+    if (!perluDicatat(req.method, req.url, reply.statusCode)) return;
+    req.log.info(`${req.method} ${req.url} -> ${reply.statusCode} (${Math.round(reply.elapsedTime)} ms)`);
+  });
+  if (env.TRUST_PROXY !== false) { // Modul 27: satu baris saat menyala, bukti setelan TRUST_PROXY terbaca
+    app.log.info(`penerus tepercaya (TRUST_PROXY): ${env.TRUST_PROXY === true ? "semua" : env.TRUST_PROXY.join(", ")}`);
+  }
+  app.setValidatorCompiler(validatorCompiler); // skema Zod memeriksa isi permintaan...
+  app.setSerializerCompiler(serializerCompiler); // ...dan bentuk jawaban
+
+  await pasangKeamanan(app); // Modul 20: CORS, cookie, JWT, rate limit, dan satpam di setiap permintaan (SEBELUM rute)
+  await app.register(swagger, {
+    openapi: {
+      info: {
+        title: "Rumah Pintar Mini API",
+        description: "Backend Rumah Pintar Mini. Semua rute butuh login, kecuali yang tidak bergembok. Login dulu lewat "
+          + "POST /auth/login (Try it out): browser menyimpan cookie akses dan mengirimnya sendiri ke rute lain. "
+          + "Akun viewer hanya boleh melihat (GET); perintah dan perubahan dijawab 403. Perangkat didaftarkan admin lewat "
+          + "POST /devices; kuncinya hanya tampil sekali, dan pesan dari perangkat tak terdaftar atau dicabut diabaikan. "
+          + "Sejak v1.1, aturan ambang bisa berarah turun (ambang-bawah, misalnya siram kalau tanah di bawah 30 %), boleh "
+          + "mengirim satu perintah saat menyala, dan aturan bisa dihapus (DELETE /rules/:id). Sejak v1.2, GET /devices "
+          + "membawa titik peta setiap perangkat (lat, lng), dan admin memindahkannya lewat PUT /devices/:id/lokasi. "
+          + "Laporan harian CSV dikirim ke Telegram sesuai LAPORAN_JADWAL (bawaan 07.00 WIB); POST /laporan/kirim "
+          + "mengirimnya sekarang juga. Sejak v1.3 (Modul 26), backend juga berjalan sebagai kontainer di Docker Compose: "
+          + "dashboard memanggilnya lewat penyaji web Caddy dengan awalan /api, sedangkan halaman ini dibuka di "
+          + "http://localhost:8080/docs (di kontainer, login dari http://127.0.0.1:8080/docs ditolak 403). Sejak v1.4 "
+          + "(Modul 27), backend bisa dibuka dari internet di balik Caddy HTTPS: dengan TRUST_PROXY (di Compose: uniquelocal) "
+          + "backend memakai alamat IP dan protokol tamu dari Caddy, jadi cookie login ber-Secure dan batas 10 percobaan "
+          + "login berlaku per tamu. Sejak v1.5 (Modul 28): pembaruan firmware lewat udara (unggah POST /firmware/:jenis/:versi, "
+          + "perintah POST /devices/:id/update, canary lalu POST /armada/update), unduhan firmware untuk perangkat di "
+          + "GET /fw/node-1/<versi>.bin yang dikunci kunci perangkat, data halaman /armada (GET /armada), kode klaim sekali "
+          + "pakai (POST /provision/kode untuk admin, POST /provision/klaim untuk perangkat), jeda vitals jarak jauh, dan "
+          + "akun broker perangkat yang dibuat serta dihapus otomatis (AKUN_BROKER_OTOMATIS). Sejak 2.0.0 (Modul 29): satu "
+          + "nomor versi untuk backend dan dashboard, dibaca dari package.json (angka di samping judul halaman ini), dan "
+          + "GET /health menyebut versi yang sedang berjalan.",
+        version: VERSI_SERVER, // Modul 29: dari package.json, bukan lagi ditulis tangan di sini
+      },
+      components: {
+        securitySchemes: { // Modul 20: rute bergembok butuh cookie akses dari POST /auth/login
+          cookieAkses: { type: "apiKey", in: "cookie", name: "akses", description: "JWT akses (httpOnly) dari POST /auth/login" },
+        },
+      },
+      security: [{ cookieAkses: [] }], // bawaan: semua rute bergembok; rute terbuka menulis security: []
+    },
+    transform: jsonSchemaTransform, // skema Zod yang sama menjadi dokumentasi OpenAPI
+  });
+  await app.register(swaggerUi, { routePrefix: "/docs" });
+  await app.register(ruteAuth); // Modul 20
+  await app.register(ruteKesehatan);
+  await app.register(rutePerangkat);
+  await app.register(ruteAturan); // Modul 19
+  await app.register(ruteLaporan); // Modul 25
+  await app.register(ruteFirmware); // Modul 28: rilis firmware dan unduhan berkunci /fw
+  await app.register(ruteArmada); // Modul 28: halaman /armada, perintah update, canary, jeda vitals
+  await app.register(ruteKlaim); // Modul 28: kode klaim
+  return app;
+}
diff --git a/backend/src/config/versi-server.ts b/backend/src/config/versi-server.ts
new file mode 100644
index 0000000..948d995
--- /dev/null
+++ b/backend/src/config/versi-server.ts
@@ -0,0 +1,13 @@
+// versi-server.ts - versi server Rumah Pintar Mini yang SEDANG berjalan, dibaca dari package.json (Modul 29).
+// Sejak 2.0.0 proyek memakai SATU nomor versi untuk backend dan dashboard (sama dengan tag image dan tag Git v2.0.0). Nomor
+// itu ditulis sekali di package.json, dinaikkan lewat pull request (robot memeriksanya dengan skrip/cek-versi.mjs), lalu
+// dibaca di sini saat server menyala. Dipakai dua tempat: GET /health (kolom versi: siapa pun bisa memeriksa versi yang
+// terpasang di produksi tanpa SSH) dan dokumentasi API /docs (OpenAPI info.version). Tidak ada lagi versi yang ditulis
+// tangan di kode, jadi tidak ada yang bisa lupa diubah.
+// Di image Docker, package.json ikut disalin ke /app (Dockerfile), jadi jalur ../../package.json sama di laptop dan di
+// kontainer. Bukan services/versi.ts: berkas itu membandingkan versi FIRMWARE perangkat (Modul 28), urusan yang lain.
+import { readFileSync } from "node:fs";
+
+const paket = JSON.parse(readFileSync(new URL("../../package.json", import.meta.url), "utf8")) as { version: string };
+
+export const VERSI_SERVER: string = paket.version; // misalnya "2.0.0"
diff --git a/backend/src/integrasi/aturan.test.ts b/backend/src/integrasi/aturan.test.ts
new file mode 100644
index 0000000..5615fe9
--- /dev/null
+++ b/backend/src/integrasi/aturan.test.ts
@@ -0,0 +1,91 @@
+// aturan.test.ts - tes INTEGRASI aturan otomatis (Modul 19 + 24) dengan tabel rules dan events SUNGGUHAN (Modul 29).
+// Yang tidak bisa diuji tiruan: kondisi dan aksi tersimpan sebagai JSONB, kolom diubah maju saat aturan diganti, dan kunci
+// asing events.aturan_id ON DELETE SET NULL (migrasi 007): aturan dihapus, buku kejadiannya tetap ada.
+// Jalankan (database uji menyala, DATABASE_URL_UJI terisi; lihat siapkan.ts): npm run test:integrasi
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { adaDatabaseUji, siapkanUji, tungguKueriSelesai } from "./siapkan.ts";
+import type { Uji } from "./siapkan.ts";
+
+// nama aturan milik berkas ini saja (awalan yang sama dipakai bersih-bersih). device_id hanya disimpan di dalam JSON aturan;
+// perangkatnya tidak harus ada di tabel devices.
+const AWALAN = "uji-integrasi aturan";
+const PERANGKAT = "290400000001";
+
+// "kipas menyala kalau suhu di atas <nyala> °C selama 60 detik, padam lagi di bawah <nyala - 2> °C"
+function aturanKipas(nama: string, nyala = 30, aktif = true) {
+  return {
+    nama, aktif,
+    kondisi: { jenis: "ambang", device_id: PERANGKAT, besaran: "suhu", nyala_di_atas: nyala, padam_di_bawah: nyala - 2,
+      selama_detik: 60 },
+    aksi: { jenis: "sakelar", device_id: PERANGKAT, target: "kipas", kabari: false },
+  };
+}
+
+describe.skipIf(!adaDatabaseUji)("integrasi (database uji): aturan otomatis", () => {
+  let uji: Uji;
+  const buat = (isi: object) => uji.app.inject({ method: "POST", url: "/rules", cookies: uji.gelang("admin"), payload: isi });
+  const bersihkan = async () => {
+    await tungguKueriSelesai(uji.pool); // kejadian dari tes sebelumnya mungkin masih ditulis
+    await uji.pool.query("DELETE FROM events WHERE data->>'nama' LIKE $1", [`${AWALAN}%`]); // kejadian "aturan-diubah"
+    await uji.pool.query("DELETE FROM rules WHERE nama LIKE $1", [`${AWALAN}%`]);
+  };
+
+  beforeAll(async () => { uji = await siapkanUji(); }, 60_000); // migrasi bisa menunggu giliran berkas lain
+  beforeEach(() => bersihkan());
+  afterAll(async () => {
+    if (!uji) return; // siapkanUji() gagal: galatnya sudah dilaporkan
+    await bersihkan();
+    await uji.tutup();
+  });
+
+  it("POST /rules: aturan tersimpan di tabel rules (JSONB) dan langsung tampil; isi tidak sah ditolak 400 tanpa baris baru", async () => {
+    const jawab = await buat(aturanKipas(`${AWALAN} 1`));
+    expect(jawab.statusCode).toBe(201);
+    const { id } = jawab.json() as { id: number };
+
+    const baris = await uji.pool.query("SELECT nama, aktif, kondisi, aksi FROM rules WHERE id = $1", [id]);
+    expect(baris.rows).toEqual([aturanKipas(`${AWALAN} 1`)]); // JSONB dibaca kembali sebagai objek yang sama persis
+    const daftar = await uji.app.inject({ method: "GET", url: "/rules", cookies: uji.gelang("viewer") });
+    expect((daftar.json() as { id: number }[]).map((a) => a.id)).toContain(id);
+
+    // histeresis terbalik (padam di atas nyala): ditolak skema Zod sebelum menyentuh database
+    const salah = await buat({ ...aturanKipas(`${AWALAN} salah`), kondisi: { ...aturanKipas("").kondisi, padam_di_bawah: 35 } });
+    expect(salah.statusCode).toBe(400);
+    expect((await uji.pool.query("SELECT 1 FROM rules WHERE nama = $1", [`${AWALAN} salah`])).rowCount).toBe(0);
+  });
+
+  it("PUT /rules/:id: isi diganti di database dan kolom diubah maju; nomor yang tidak ada dijawab 404", async () => {
+    const { id } = (await buat(aturanKipas(`${AWALAN} 2`))).json() as { id: number };
+    const ganti = await uji.app.inject({ method: "PUT", url: `/rules/${id}`, cookies: uji.gelang("admin"),
+      payload: aturanKipas(`${AWALAN} 2 diganti`, 32, false) });
+    expect(ganti.statusCode).toBe(200);
+
+    // "diubah maju" dibandingkan di dalam database (mikrodetik): Date di JavaScript hanya sampai milidetik, jadi INSERT dan
+    // UPDATE di milidetik yang sama di komputer cepat akan tampak sama
+    const baris = await uji.pool.query<{ nama: string; aktif: boolean; nyala: number; maju: boolean }>(
+      "SELECT nama, aktif, (kondisi->>'nyala_di_atas')::int AS nyala, diubah > dibuat AS maju FROM rules WHERE id = $1", [id]);
+    expect(baris.rows[0]).toEqual({ nama: `${AWALAN} 2 diganti`, aktif: false, nyala: 32, maju: true });
+
+    const tidakAda = await uji.app.inject({ method: "PUT", url: "/rules/2147483647", cookies: uji.gelang("admin"),
+      payload: aturanKipas(`${AWALAN} hantu`) });
+    expect(tidakAda.statusCode).toBe(404);
+  });
+
+  it("DELETE /rules/:id: aturan hilang dari database, buku kejadiannya tetap (aturan_id menjadi NULL)", async () => {
+    const { id } = (await buat(aturanKipas(`${AWALAN} 3`))).json() as { id: number };
+    // membuat aturan menulis satu kejadian "aturan-diubah" yang menunjuk aturan itu (ditulis tanpa ditunggu rute)
+    let nomorKejadian = 0;
+    await vi.waitFor(async () => {
+      const kejadian = await uji.pool.query<{ id: string }>("SELECT id FROM events WHERE aturan_id = $1", [id]);
+      expect(kejadian.rowCount).toBe(1);
+      nomorKejadian = Number(kejadian.rows[0].id);
+    });
+
+    const hapus = await uji.app.inject({ method: "DELETE", url: `/rules/${id}`, cookies: uji.gelang("admin") });
+    expect(hapus.statusCode).toBe(200);
+    expect((await uji.pool.query("SELECT 1 FROM rules WHERE id = $1", [id])).rowCount).toBe(0);
+    // kunci asing ON DELETE SET NULL: kejadian lama tetap ada, hanya penunjuk aturannya yang dikosongkan
+    const lama = await uji.pool.query("SELECT jenis, aturan_id FROM events WHERE id = $1", [nomorKejadian]);
+    expect(lama.rows).toEqual([{ jenis: "aturan-diubah", aturan_id: null }]);
+  });
+});
diff --git a/backend/src/integrasi/bacaan.test.ts b/backend/src/integrasi/bacaan.test.ts
new file mode 100644
index 0000000..304f838
--- /dev/null
+++ b/backend/src/integrasi/bacaan.test.ts
@@ -0,0 +1,89 @@
+// bacaan.test.ts - tes INTEGRASI riwayat bacaan (Modul 17-18) di hypertable readings TimescaleDB SUNGGUHAN (Modul 29).
+// Yang tidak bisa diuji tabel tiruan: urutan dan batas waktu dari SQL (ORDER BY ts, ts >= ... AND ts < ...), fungsi
+// time_bucket() milik TimescaleDB untuk ringkasan per 15 menit, dan PRIMARY KEY (device_id, ts) + ON CONFLICT DO NOTHING yang
+// membuang kiriman ganda.
+// Jalankan (database uji menyala, DATABASE_URL_UJI terisi; lihat siapkan.ts): npm run test:integrasi
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { adaDatabaseUji, hapusPerangkatUji, siapkanUji } from "./siapkan.ts";
+import type { Uji } from "./siapkan.ts";
+
+// device_id milik berkas ini saja (awalan 2902)
+const SATU = "290200000001";
+const TETANGGA = "290200000002";
+const GANDA = "290200000003";
+const SEMUA = [SATU, TETANGGA, GANDA];
+const MENIT = 60_000;
+
+describe.skipIf(!adaDatabaseUji)("integrasi (database uji): riwayat bacaan", () => {
+  let uji: Uji;
+  // bacaan cukup punya perangkat di tabel devices (kunci asing readings -> devices); tidak perlu didaftarkan lewat API
+  const adakanPerangkat = (id: string) => uji.pool.query("INSERT INTO devices (device_id) VALUES ($1)", [id]);
+  const simpanBacaan = (id: string, ts: Date, suhu: number) =>
+    uji.pool.query("INSERT INTO readings (device_id, ts, fw, suhu, kelembapan) VALUES ($1, $2, '1.7.0', $3, 60)", [id, ts, suhu]);
+
+  beforeAll(async () => { uji = await siapkanUji(); }, 60_000); // migrasi bisa menunggu giliran berkas lain
+  beforeEach(() => hapusPerangkatUji(uji.pool, SEMUA));
+  afterAll(async () => {
+    if (!uji) return; // siapkanUji() gagal: galatnya sudah dilaporkan
+    await hapusPerangkatUji(uji.pool, SEMUA);
+    await uji.tutup();
+  });
+
+  it("GET /devices/:id/readings: hanya bacaan 1 jam terakhir, urut waktu (terlama lebih dulu)", async () => {
+    await adakanPerangkat(SATU);
+    const sekarang = Date.now();
+    // disimpan ACAK urutannya: urutan di jawaban harus datang dari ORDER BY ts, bukan dari urutan simpan
+    await simpanBacaan(SATU, new Date(sekarang - 10 * MENIT), 23.5);
+    await simpanBacaan(SATU, new Date(sekarang - 50 * MENIT), 21.5);
+    await simpanBacaan(SATU, new Date(sekarang - 30 * MENIT), 22.5);
+    await simpanBacaan(SATU, new Date(sekarang - 180 * MENIT), 99); // 3 jam lalu: di luar rentang bawaan (1 jam)
+
+    const jawab = await uji.app.inject({ method: "GET", url: `/devices/${SATU}/readings`, cookies: uji.gelang("viewer") });
+    expect(jawab.statusCode).toBe(200);
+    const isi = jawab.json() as { jumlah: number; terpotong: boolean; bacaan: { suhu: number | null }[] };
+    expect(isi.jumlah).toBe(3);
+    expect(isi.terpotong).toBe(false);
+    expect(isi.bacaan.map((b) => b.suhu)).toEqual([21.5, 22.5, 23.5]);
+  });
+
+  it("ringkasan per 15 menit (time_bucket TimescaleDB): hanya bacaan perangkat itu yang dihitung", async () => {
+    await adakanPerangkat(SATU);
+    await adakanPerangkat(TETANGGA);
+    // awal satu ember 15 menit, dua jam lalu (dibulatkan ke bawah ke kelipatan 15 menit)
+    const awal = Math.floor((Date.now() - 120 * MENIT) / (15 * MENIT)) * (15 * MENIT);
+    await simpanBacaan(SATU, new Date(awal + 1 * MENIT), 20);
+    await simpanBacaan(SATU, new Date(awal + 4 * MENIT), 22);
+    await simpanBacaan(SATU, new Date(awal + 7 * MENIT), 24);
+    await simpanBacaan(TETANGGA, new Date(awal + 2 * MENIT), 90); // perangkat lain di ember yang sama: tidak boleh ikut
+    await simpanBacaan(TETANGGA, new Date(awal + 5 * MENIT), 95);
+
+    const rentang = new URLSearchParams({ bucket: "15m", from: new Date(awal).toISOString(),
+      to: new Date(awal + 15 * MENIT).toISOString() });
+    const jawab = await uji.app.inject({ method: "GET", url: `/devices/${SATU}/readings?${rentang}`,
+      cookies: uji.gelang("viewer") });
+    expect(jawab.statusCode).toBe(200);
+    const isi = jawab.json() as { ringkasan: Record<string, unknown>[] };
+    expect(isi.ringkasan).toEqual([{
+      waktu: new Date(awal).toISOString().slice(0, 19) + "Z", // format kontrak: UTC tanpa milidetik
+      suhu_rata: 22, suhu_min: 20, suhu_maks: 24, kelembapan_rata: 60, tanah_rata: null, cahaya_rata: null, jumlah_bacaan: 3,
+    }]);
+  });
+
+  it("kiriman ganda: telemetry yang sama dua kali (ts sama) tersimpan satu baris (PRIMARY KEY + ON CONFLICT)", async () => {
+    await adakanPerangkat(GANDA);
+    // fungsi yang dipanggil mqtt.ts untuk setiap telemetry yang lolos kontrak (diimpor sesudah siapkanUji mengisi setelan)
+    const { arsipkanTelemetry } = await import("../db/arsip.ts");
+    const telemetry = { ts: new Date(Date.now() - 5 * MENIT).toISOString().slice(0, 19) + "Z", fw: "1.7.0", suhu: 27.5,
+      kelembapan: 61, cahaya: 900, tanah: 40, gerak: false, level_air: 80 };
+
+    expect(await arsipkanTelemetry(GANDA, telemetry)).toBe(true); // pertama: tersimpan
+    expect(await arsipkanTelemetry(GANDA, telemetry)).toBe(false); // kedua (QoS 1 boleh mengirim ulang): dilewati, tanpa galat
+    const baris = await uji.pool.query("SELECT suhu, kelembapan, cahaya FROM readings WHERE device_id = $1", [GANDA]);
+    expect(baris.rows).toEqual([{ suhu: 27.5, kelembapan: 61, cahaya: 900 }]);
+    // telemetry juga memperbarui baris perangkatnya: jenis dikenali dari isinya, waktu terakhir terdengar terisi
+    const perangkat = await uji.pool.query<{ jenis: string; terakhir_dilihat: Date | null }>(
+      "SELECT jenis, terakhir_dilihat FROM devices WHERE device_id = $1", [GANDA]);
+    expect(perangkat.rows[0].jenis).toBe("node1");
+    expect(perangkat.rows[0].terakhir_dilihat).toBeInstanceOf(Date);
+  });
+});
diff --git a/backend/src/integrasi/firmware-armada.test.ts b/backend/src/integrasi/firmware-armada.test.ts
new file mode 100644
index 0000000..3c2c06a
--- /dev/null
+++ b/backend/src/integrasi/firmware-armada.test.ts
@@ -0,0 +1,115 @@
+// firmware-armada.test.ts - tes INTEGRASI rilis firmware dan halaman /armada (Modul 28) dengan database uji SUNGGUHAN dan folder
+// firmware sementara (Modul 29). Yang tidak bisa diuji tiruan: metadata rilis di tabel firmware (PRIMARY KEY jenis + versi:
+// versi tidak bisa ditimpa), unduhan berkunci yang mencocokkan kunci perangkat dengan sidik di tabel devices, tanda rilis uji
+// dan rilis ditarik, serta kueri LATERAL halaman /armada (kesehatan TERAKHIR dan pembaruan terakhir setiap perangkat).
+// Berkas .bin di sini tiruan: 4 KiB acak dengan bait pertama 0xE9 (server hanya memeriksa bait itu dan ukurannya).
+// Jalankan (database uji menyala, DATABASE_URL_UJI terisi; lihat siapkan.ts): npm run test:integrasi
+import { createHash, randomBytes } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { adaDatabaseUji, daftarkanPerangkat, hapusPerangkatUji, siapkanUji } from "./siapkan.ts";
+import type { Uji } from "./siapkan.ts";
+
+// device_id dan versi firmware milik berkas ini saja (awalan 2906 dan 29.6.x)
+const PENGUNDUH = "290600000001";
+const ANGGOTA = "290600000002";
+const SEMUA = [PENGUNDUH, ANGGOTA];
+const sha256 = (isi: Buffer) => createHash("sha256").update(isi).digest("hex");
+
+function binTiruan(): Buffer {
+  const isi = randomBytes(4096);
+  isi[0] = 0xe9; // tanda citra aplikasi ESP32
+  return isi;
+}
+
+describe.skipIf(!adaDatabaseUji)("integrasi (database uji): rilis firmware dan armada", () => {
+  let uji: Uji;
+  const unggah = (versi: string, isi: Buffer, rilisUji = false) => uji.app.inject({ method: "POST",
+    url: `/firmware/node1/${versi}${rilisUji ? "?uji=true" : ""}`, cookies: uji.gelang("admin"),
+    headers: { "content-type": "application/octet-stream" }, payload: isi });
+  const bersihkan = async () => {
+    await hapusPerangkatUji(uji.pool, SEMUA); // juga baris pembaruan yang menunjuk rilis di bawah
+    await uji.pool.query("DELETE FROM firmware WHERE versi LIKE '29.6.%'");
+  };
+
+  beforeAll(async () => { uji = await siapkanUji(); }, 60_000); // migrasi bisa menunggu giliran berkas lain
+  beforeEach(async () => {
+    await bersihkan();
+    // Dua tes di bawah menilai "rilis terbaru" dari SEMUA baris tabel firmware: rilis lain di database uji (misalnya sisa
+    // mencoba unggah firmware) membuat hasilnya salah. Berhenti dengan pesan jelas, bukan AssertionError yang membingungkan.
+    const lain = await uji.pool.query<{ versi: string }>("SELECT versi FROM firmware WHERE versi NOT LIKE '29.6.%'");
+    if (lain.rowCount) {
+      throw new Error(`tabel firmware di database uji berisi rilis lain (${lain.rows.map((r) => r.versi).join(", ")}): `
+        + "tes ini butuh tabel firmware tanpa rilis lain. Pakai database uji yang baru (nyalakan ulang kontainernya).");
+    }
+  });
+  afterAll(async () => {
+    if (!uji) return; // siapkanUji() gagal: galatnya sudah dilaporkan
+    await bersihkan();
+    await uji.tutup();
+  });
+
+  it("unggah: metadata (ukuran, SHA-256 hitungan server) tersimpan, versi tidak bisa ditimpa, perangkat mengunduh dengan kuncinya", async () => {
+    const isi = binTiruan();
+    expect((await unggah("29.6.1", isi)).statusCode).toBe(201);
+    const baris = await uji.pool.query("SELECT ukuran, sha256, uji, pengunggah, ditarik FROM firmware WHERE versi = '29.6.1'");
+    expect(baris.rows).toEqual([{ ukuran: 4096, sha256: sha256(isi), uji: false, pengunggah: "1", ditarik: null }]);
+    expect((await readFile(join(uji.folderFirmware, "node-1", "29.6.1.bin"))).equals(isi)).toBe(true); // berkas di lemari
+    expect((await unggah("29.6.1", binTiruan())).statusCode).toBe(409); // isi lain, versi sama: ditolak
+
+    // unduhan perangkat: Basic Auth device_id:kunci (dicocokkan dengan sidik di tabel devices) + MAC WiFi-nya
+    const kunci = await daftarkanPerangkat(uji, PENGUNDUH);
+    const unduh = (kunciDibawa: string) => uji.app.inject({ method: "GET", url: "/fw/node-1/29.6.1.bin", headers: {
+      authorization: `Basic ${Buffer.from(`${PENGUNDUH}:${kunciDibawa}`).toString("base64")}`,
+      "x-esp32-sta-mac": "29:06:00:00:00:01" } });
+    const berhasil = await unduh(kunci);
+    expect(berhasil.statusCode).toBe(200);
+    expect(berhasil.headers["x-sha256"]).toBe(sha256(isi));
+    expect(berhasil.rawPayload.equals(isi)).toBe(true);
+    const kunciPalsu = kunci.slice(0, -1) + (kunci.endsWith("A") ? "B" : "A"); // huruf terakhir diganti: satu huruf beda
+    expect((await unduh(kunciPalsu)).statusCode).toBe(403);
+  });
+
+  it("rilis uji tersimpan bertanda uji dan tidak pernah menjadi rilis terbaru; rilis yang ditarik keluar dari hitungan", async () => {
+    expect((await unggah("29.6.2", binTiruan())).statusCode).toBe(201);
+    expect((await unggah("29.6.3", binTiruan(), true)).statusCode).toBe(201); // lebih tinggi, tetapi rilis UJI
+    const tanda = await uji.pool.query("SELECT versi, uji FROM firmware WHERE versi LIKE '29.6.%' ORDER BY versi");
+    expect(tanda.rows).toEqual([{ versi: "29.6.2", uji: false }, { versi: "29.6.3", uji: true }]);
+
+    type Daftar = { terbaru: { node1: string | null }; rilis: { versi: string; boleh_semua: boolean; alasan_semua: string | null }[] };
+    const daftar = async () => (await uji.app.inject({ method: "GET", url: "/firmware", cookies: uji.gelang("viewer") })).json() as Daftar;
+    const sebelum = await daftar();
+    expect(sebelum.terbaru.node1).toBe("29.6.2");
+    expect(sebelum.rilis.find((r) => r.versi === "29.6.3"))
+      .toMatchObject({ boleh_semua: false, alasan_semua: "rilis uji: hanya per perangkat" });
+
+    const tarik = await uji.app.inject({ method: "POST", url: "/firmware/node1/29.6.2/tarik", cookies: uji.gelang("admin") });
+    expect(tarik.statusCode).toBe(200);
+    const ditarik = await uji.pool.query<{ ditarik: Date | null }>("SELECT ditarik FROM firmware WHERE versi = '29.6.2'");
+    expect(ditarik.rows[0].ditarik).toBeInstanceOf(Date);
+    expect((await daftar()).terbaru.node1).toBeNull(); // tinggal rilis uji: tidak ada rilis terbaru
+  });
+
+  it("GET /armada: perangkat tampil dengan kesehatan TERAKHIR dan pembaruan terakhirnya (LATERAL), perlu_update dari rilis terbaru", async () => {
+    await daftarkanPerangkat(uji, ANGGOTA, "Node armada uji");
+    // seolah perangkat sudah berjalan: melaporkan versi 29.5.0, dua kali mengirim vitals, dan pernah gagal memasang 29.6.4
+    await uji.pool.query("UPDATE devices SET jenis = 'node1', fw = '29.5.0', fw_dilihat = now() WHERE device_id = $1", [ANGGOTA]);
+    await uji.pool.query(`INSERT INTO device_health (device_id, ts, rssi, uptime_s, heap_free, reset_reason, fw) VALUES
+      ($1, now() - interval '20 minutes', -70, 600, 150000, 'POWERON', '29.5.0'),
+      ($1, now() - interval '2 minutes', -55, 1680, 148000, 'POWERON', '29.5.0')`, [ANGGOTA]);
+    expect((await unggah("29.6.4", binTiruan())).statusCode).toBe(201);
+    await uji.pool.query(`INSERT INTO pembaruan (id, device_id, dari_versi, ke_versi, status, pesan, selesai)
+      VALUES ('c-uji-290600000002', $1, '29.5.0', '29.6.4', 'rollback', 'masa uji gagal', now())`, [ANGGOTA]);
+
+    const jawab = await uji.app.inject({ method: "GET", url: "/armada", cookies: uji.gelang("viewer") });
+    expect(jawab.statusCode).toBe(200);
+    const isi = jawab.json() as { rilis_terbaru: { node1: string | null }; perangkat: { device_id: string }[] };
+    expect(isi.rilis_terbaru.node1).toBe("29.6.4");
+    expect(isi.perangkat.find((p) => p.device_id === ANGGOTA)).toMatchObject({
+      nama: "Node armada uji", kunci: "aktif", fw: "29.5.0", perlu_update: true,
+      kesehatan: { rssi: -55, uptime_s: 1680, reset_reason: "POWERON" }, // baris 2 menit lalu, bukan 20 menit lalu
+      pembaruan: { status: "rollback", dari: "29.5.0", ke: "29.6.4", pesan: "masa uji gagal" },
+    });
+  });
+});
