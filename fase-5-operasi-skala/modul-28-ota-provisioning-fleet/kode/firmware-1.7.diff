+static int pecahKata(const String& teks, String kata[], int maks) {
+  int banyak = 0;
+  int i = 0;
+  int n = teks.length();
+  while (i < n) {
+    while (i < n && teks[i] == ' ') {
+      i++;
+    }
+    if (i >= n) {
