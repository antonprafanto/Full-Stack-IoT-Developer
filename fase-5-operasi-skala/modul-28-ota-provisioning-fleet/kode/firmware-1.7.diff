+  if (strcmp(alamat, broker) != 0) {  // sama: tidak perlu menulis ulang
+    arsip.putString("alamat_broker", alamat);  // 13 huruf
+    snprintf(broker, sizeof(broker), "%s", alamat);
+    logInfo("Alamat broker disimpan ke NVS: %s", broker);
