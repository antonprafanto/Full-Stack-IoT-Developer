+    klienJaringan.clear();
+    mqtt.disconnect();  // DISCONNECT rapi
+    logInfo("Status offline-mode terbit, sambungan broker diputus rapi (tanpa wasiat offline).");
+  }
+  mqttTersambung = false;  // supaya jagaMqtt() tidak menulis "MQTT PUTUS"
