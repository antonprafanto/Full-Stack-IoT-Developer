+    const kode = Array.from({ length: 200 }, buatKodeKlaim);
+    for (const k of kode) expect(k).toMatch(/^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$/);
