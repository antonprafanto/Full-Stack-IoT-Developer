+  it("bentuk yang tetap salah = null (U bukan huruf Crockford, panjang salah)", () => {
+    expect(rapikanKodeKlaim("UUUU-UUUU")).toBeNull();
+    expect(rapikanKodeKlaim("7K2M-QF9")).toBeNull();
+    expect(rapikanKodeKlaim("7K2M-QF9DX")).toBeNull();
