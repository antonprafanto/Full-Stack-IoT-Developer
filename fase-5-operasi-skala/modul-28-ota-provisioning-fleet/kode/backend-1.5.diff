+  jenis: z.enum(["node1"]).describe("jenis perangkat; hanya node1 (Node 2 tidak diperbarui lewat udara)"),
+  versi: VersiRilis.describe("versi SemVer firmware, misalnya 1.7.1 (sama dengan VERSI_FIRMWARE di konfigurasi.h)"),
+});
