+    expect(hashKodeKlaim(rapi)).toBe(createHash("sha256").update("7K2MQF9D").digest("hex"));
+    expect(hashKodeKlaim(rapikanKodeKlaim("7K2M QF9D") ?? "")).toBe(hashKodeKlaim(rapi));
