{
  "name": "rumah-pintar-mini-backend",
  "version": "0.1.0",
  "description": "Backend Rumah Pintar Mini (Modul 16): mendengar MQTT, memeriksa kontrak data, dan menyediakan API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "cek": "tsc --noEmit",
    "migrasi": "node --env-file=.env src/db/migrasi.ts",
    "isi-riwayat": "node --env-file=.env src/db/isi-riwayat.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
