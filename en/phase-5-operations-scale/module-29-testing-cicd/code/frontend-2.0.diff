diff --git a/frontend/src/rules.test.ts b/frontend/src/rules.test.ts
new file mode 100644
index 0000000..afaff20
--- /dev/null
+++ b/frontend/src/rules.test.ts
@@ -0,0 +1,33 @@
+// rules.test.ts - tests of the automation rule sentences (Module 29): a rule's JSON stored on the server becomes the sentence
+// the home owner reads on the Rules screen. Pure functions: no browser, no backend. Run from the frontend folder: npm test
+import { describe, expect, it } from "vitest";
+import { describeRule } from "./rules";
+import type { Rule } from "./schemas/rule-basics";
+
+// device_id -> a name humans know (in the dashboard, this name comes from the device list)
+function name(deviceId: string): string {
+  return deviceId === "f00d00000001" ? "Living room" : "Garden";
+}
+
+describe("rules as sentences (rules.ts)", () => {
+  it("describeRule: the Module 19 fan rule and the morning watering schedule become sentences", () => {
+    const fan: Rule = {
+      name: "automatic fan",
+      active: true,
+      condition: { kind: "threshold", device_id: "f00d00000001", quantity: "temperature", on_above: 30, off_below: 28.5, for_seconds: 60 },
+      action: { kind: "switch", device_id: "f00d00000001", target: "fan", notify: false },
+    };
+    expect(describeRule(fan, name)).toBe(
+      "If the temperature on Living room is above 30 °C for 60 seconds, turn on the fan. " +
+        "The fan turns off again after the temperature falls below 28.5 °C.",
+    );
+
+    const morningWatering: Rule = {
+      name: "morning watering",
+      active: true,
+      condition: { kind: "schedule", cron: "0 6 * * *" }, // minute 0, hour 6, every day
+      action: { kind: "command", device_id: "f00d000000b2", command: { target: "pump", value: 5 }, notify: true },
+    };
+    expect(describeRule(morningWatering, name)).toBe("Every day at 06:00 WIB, water for 5 seconds on Garden. Notify via Telegram.");
+  });
+});
diff --git a/frontend/src/time.test.ts b/frontend/src/time.test.ts
new file mode 100644
index 0000000..8b9b134
--- /dev/null
+++ b/frontend/src/time.test.ts
@@ -0,0 +1,32 @@
+// time.test.ts - tests of the clock helpers on the screen (Module 29). The dashboard clock is always WIB, whatever the time zone
+// of the laptop, the phone, or the robot computer running them (the GitHub Actions robot uses UTC). From the frontend folder: npm test
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { relativeTime, wibTime, MINUTE } from "./time";
+
+describe("the clock on the screen (time.ts)", () => {
+  // after every test: bring back this computer's own time zone (vi.stubEnv below only borrows it)
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it("wibTime: WIB time, whatever the computer's time zone", () => {
+    // UTC (the robot), WIB, WITA, WIT. vi.stubEnv("TZ", …) = as if this computer were set to that time zone. It only applies to
+    // a format made WHEN it is called (toLocaleTimeString in wibTime). The Intl.DateTimeFormat formatters made once when
+    // time.ts loads (HOUR_MINUTE and friends) use the time zone at load time: the robot on a UTC clock guards those.
+    for (const zone of ["UTC", "Asia/Jakarta", "Asia/Makassar", "Asia/Jayapura"]) {
+      vi.stubEnv("TZ", zone);
+      // Z at the end = UTC time. WIB = UTC + 7 hours.
+      expect(wibTime("2026-10-24T09:27:10Z")).toBe("16:27:10 WIB");
+      expect(wibTime("2026-10-24T17:05:00Z")).toBe("00:05:00 WIB"); // already past midnight in Indonesia
+    }
+  });
+
+  it("relativeTime: under 5 seconds 'just now' (also when the server clock runs slightly fast), after that '… ago'", () => {
+    const now = Date.parse("2026-10-24T09:30:00Z");
+    expect(relativeTime(now - 3000, now)).toBe("just now");
+    // the server clock 2 seconds ahead of the phone clock: still "just now", not "in 2 seconds"
+    expect(relativeTime(now + 2000, now)).toBe("just now");
+    expect(relativeTime(now - 45 * 1000, now)).toBe("45 seconds ago");
+    expect(relativeTime(now - 3 * MINUTE, now)).toBe("3 minutes ago");
+  });
+});
diff --git a/frontend/src/version.d.ts b/frontend/src/version.d.ts
new file mode 100644
index 0000000..2f0f79c
