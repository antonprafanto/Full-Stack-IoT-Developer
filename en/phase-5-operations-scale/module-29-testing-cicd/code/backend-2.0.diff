diff --git a/backend/src/app.ts b/backend/src/app.ts
new file mode 100644
index 0000000..2a22169
--- /dev/null
+++ b/backend/src/app.ts
@@ -0,0 +1,104 @@
+// app.ts - assembles the Mini Smart Home Fastify server WITHOUT starting it (Module 29). Its content moved as is from server.ts
+// (Modules 19-28): the logger, one log line per request, the Zod schema checker, the API protection (Module 20), the /docs
+// documentation, and 8 groups of routes.
+// Why separate? The integration tests (src/integration/) call buildApp() and then knock on its routes with app.inject() and a
+// REAL test database. So what is tested is THE SAME assembly as in production, not a mock assembly made by the tests: a route
+// someone forgot to register shows up too (example: without claimRoutes, three claim tests turn red with 404), and so does a
+// missing login guard (GET /devices without a login must be 401). server.ts only starts the rest (database, MQTT, Telegram,
+// schedules, Socket.IO) and listens at its counter.
+import Fastify, { LogController } from "fastify";
+import type { FastifyInstance } from "fastify";
+import swagger from "@fastify/swagger";
+import swaggerUi from "@fastify/swagger-ui";
+import { jsonSchemaTransform, serializerCompiler, validatorCompiler } from "fastify-type-provider-zod";
+import { env } from "./config/env.ts";
+import { SERVER_VERSION } from "./config/server-version.ts";
+import { setupSecurity } from "./auth/security.ts";
+import { authRoutes } from "./routes/auth.ts";
+import { healthRoutes } from "./routes/health.ts";
+import { deviceRoutes } from "./routes/devices.ts";
+import { ruleRoutes } from "./routes/rules.ts";
+import { reportRoutes } from "./routes/reports.ts";
+import { firmwareRoutes } from "./routes/firmware.ts";
+import { fleetRoutes } from "./routes/fleet.ts";
+import { claimRoutes } from "./routes/claims.ts";
+import { useLog, shouldLog } from "./services/log.ts";
+
+export interface AppOptions {
+  // "pretty" (the default, server.ts) = the colored pino-pretty log, as since Module 19.
+  // "errors-only" (the integration tests) = only errors are written, one JSON line without colors: the Vitest output stays
+  // clean, but the reason for a 503 answer (for example an SQL query the database refused) can still be read when a test is red.
+  log?: "pretty" | "errors-only";
+}
+
+export async function buildApp(options: AppOptions = {}): Promise<FastifyInstance> {
+  const app = Fastify({
+    logger: options.log === "errors-only"
+      ? { level: "error" }
+      : { transport: { target: "pino-pretty", options: { translateTime: "SYS:HH:MM:ss", ignore: "pid,hostname,reqId" } } },
+    logController: new LogController({ disableRequestLogging: true }), // the built-in log per request is too long...
+    // Module 27: the X-Forwarded-For/-Proto headers from Caddy are only trusted when they come from a proxy in TRUST_PROXY (in
+    // compose.cloud.yml: uniquelocal = the Docker hallway). Empty (dev mode) = those headers are ignored, as in v1.3.
+    trustProxy: env.TRUST_PROXY,
+  });
+  useLog(app.log); // Module 19: other services (commands, rules, schedules, Telegram) write to the same log
+  app.addHook("onResponse", async (req, reply) => {
+    // ...so it's replaced by one line per request (hook = Fastify's "middleware"). Only the method, the address, and the status
+    // code: the request content (passwords!) and the cookies (tokens!) are never written to the log. Module 26: successful /health
+    // knocks (the Docker healthcheck every 15 seconds) aren't logged, so the log doesn't fill up with the same line.
+    if (!shouldLog(req.method, req.url, reply.statusCode)) return;
+    req.log.info(`${req.method} ${req.url} -> ${reply.statusCode} (${Math.round(reply.elapsedTime)} ms)`);
+  });
+  if (env.TRUST_PROXY !== false) { // Module 27: one line at startup, proof that the TRUST_PROXY setting was read
+    app.log.info(`trusted proxies (TRUST_PROXY): ${env.TRUST_PROXY === true ? "all" : env.TRUST_PROXY.join(", ")}`);
+  }
+  app.setValidatorCompiler(validatorCompiler); // Zod schemas check the content of requests...
+  app.setSerializerCompiler(serializerCompiler); // ...and the shape of replies
+
+  await setupSecurity(app); // Module 20: CORS, cookies, JWT, rate limit, and the guard on every request (BEFORE the routes)
+  await app.register(swagger, {
+    openapi: {
+      info: {
+        title: "Mini Smart Home API",
+        description: "The Mini Smart Home backend. Every route needs a login, except the ones without a padlock. Log in first with "
+          + "POST /auth/login (Try it out): the browser keeps the access cookie and sends it by itself to the other routes. "
+          + "Viewer accounts can only look (GET); commands and changes are answered with 403. Devices are registered by an admin "
+          + "with POST /devices; a key is shown only once, and messages from unregistered or revoked devices are ignored. "
+          + "Since v1.1, a threshold rule can point downwards (below-threshold, for example water when the soil is below 30 %), can "
+          + "send one command when it turns on, and rules can be deleted (DELETE /rules/:id). Since v1.2, GET /devices carries "
+          + "each device's map point (lat, lng), and the admin moves it with PUT /devices/:id/location. "
+          + "The daily CSV report is sent to Telegram at REPORT_SCHEDULE (default 07:00 WIB); POST /reports/send "
+          + "sends it right now. Since v1.3 (Module 26), the backend also runs as a container in Docker Compose: "
+          + "the dashboard calls it through the Caddy web server with the prefix /api, while this page is opened at "
+          + "http://localhost:8080/docs (in the container, a login from http://127.0.0.1:8080/docs is refused with 403). Since v1.4 "
+          + "(Module 27), the backend can be opened from the internet behind Caddy HTTPS: with TRUST_PROXY (in Compose: uniquelocal) "
+          + "the backend uses the visitor's IP address and protocol from Caddy, so the login cookies are Secure and the limit of 10 "
+          + "login attempts applies per visitor. Since v1.5 (Module 28): over-the-air firmware updates (upload POST /firmware/:kind/:version, "
+          + "the command POST /devices/:id/update, the canary, then POST /fleet/update), the firmware download for devices at "
+          + "GET /fw/node-1/<version>.bin locked with the device key, the data of the /fleet page (GET /fleet), single-use claim "
+          + "codes (POST /provision/code for the admin, POST /provision/claim for the device), the vitals interval set from afar, and "
+          + "device broker accounts that are created and deleted automatically (AUTO_BROKER_ACCOUNTS). Since 2.0.0 (Module 29): one "
+          + "version number for the backend and the dashboard, read from package.json (the number next to this page's title), and "
+          + "GET /health names the running version.",
+        version: SERVER_VERSION, // Module 29: from package.json, no longer written by hand here
+      },
+      components: {
+        securitySchemes: { // Module 20: routes with a padlock need the access cookie from POST /auth/login
+          accessCookie: { type: "apiKey", in: "cookie", name: "access", description: "access JWT (httpOnly) from POST /auth/login" },
+        },
+      },
+      security: [{ accessCookie: [] }], // default: every route has a padlock; open routes write security: []
+    },
+    transform: jsonSchemaTransform, // the same Zod schemas become the OpenAPI documentation
+  });
+  await app.register(swaggerUi, { routePrefix: "/docs" });
+  await app.register(authRoutes); // Module 20
+  await app.register(healthRoutes);
+  await app.register(deviceRoutes);
+  await app.register(ruleRoutes); // Module 19
+  await app.register(reportRoutes); // Module 25
+  await app.register(firmwareRoutes); // Module 28: firmware releases and the locked download /fw
+  await app.register(fleetRoutes); // Module 28: the /fleet page, update commands, the canary, the vitals interval
+  await app.register(claimRoutes); // Module 28: claim codes
+  return app;
+}
diff --git a/backend/src/config/server-version.ts b/backend/src/config/server-version.ts
new file mode 100644
index 0000000..57b3b0f
--- /dev/null
+++ b/backend/src/config/server-version.ts
@@ -0,0 +1,13 @@
+// server-version.ts - the version of the Mini Smart Home server that is RUNNING, read from package.json (Module 29).
+// Since 2.0.0 the project uses ONE version number for the backend and the dashboard (the same as the image tag and the Git
+// tag v2.0.0). That number is written once in package.json, raised through a pull request (the robot checks it with
+// scripts/check-version.mjs), then read here when the server starts. Used in two places: GET /health (the version field:
+// anyone can check the version deployed in production without SSH) and the API documentation /docs (OpenAPI info.version).
+// No version is written by hand in the code any more, so nothing can be forgotten.
+// In the Docker image, package.json is copied to /app too (Dockerfile), so the path ../../package.json is the same on the
+// laptop and in the container. Not services/version.ts: that file compares the devices' FIRMWARE versions (Module 28).
+import { readFileSync } from "node:fs";
+
+const pkg = JSON.parse(readFileSync(new URL("../../package.json", import.meta.url), "utf8")) as { version: string };
+
+export const SERVER_VERSION: string = pkg.version; // for example "2.0.0"
diff --git a/backend/src/integration/claims.test.ts b/backend/src/integration/claims.test.ts
new file mode 100644
index 0000000..a9c0ceb
--- /dev/null
+++ b/backend/src/integration/claims.test.ts
@@ -0,0 +1,94 @@
+// claims.test.ts - INTEGRATION tests of the single-use claim codes (Module 28) with REAL claim_codes and devices tables (Module 29).
+// What mocks can't test: exchanging a code in ONE transaction (SELECT ... FOR UPDATE, register, mark used), the code's time
+// limit by the database clock (expires_at > now()), and the ON CONFLICT that refuses taking over a device that's still active.
+// The claim route is limited to 10 attempts per minute per address: this file uses 5.
+// Run (the test database running, DATABASE_URL_TEST filled in; see setup.ts): npm run test:integration
+import { createHash } from "node:crypto";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { hashClaimCode, tidyClaimCode } from "../auth/claim-code.ts"; // pure functions (no settings), safe to import here
+import { hasTestDatabase, deleteTestDevices, setupTest } from "./setup.ts";
+import type { TestKit } from "./setup.ts";
+
+// code names and device_ids of this file only (prefix 2905)
+const PREFIX = "integration-test claim";
+const NEW_DEVICE = "290500000001";
+const OWNER = "290500000002";
+const GRABBER = "290500000003";
+const LATE = "290500000004";
+const ALL = [NEW_DEVICE, OWNER, GRABBER, LATE];
+const codeHash = (code: string) => hashClaimCode(tidyClaimCode(code) ?? "");
+
+describe.skipIf(!hasTestDatabase)("integration (test database): claim codes", () => {
+  let kit: TestKit;
+  // the admin creates a code (valid for 5 minutes); the code is only shown in this answer
+  const createCode = async (name: string) => {
+    const answer = await kit.app.inject({ method: "POST", url: "/provision/code", cookies: kit.wristband("admin"),
+      payload: { name, minutes: 5 } });
+    expect(answer.statusCode).toBe(201);
+    return (answer.json() as { code: string }).code;
+  };
+  // a device exchanges the code for its key: without a login (a device has no dashboard account)
+  const claim = (code: string, deviceId: string) =>
+    kit.app.inject({ method: "POST", url: "/provision/claim", payload: { code, device_id: deviceId } });
+  const deviceCount = async (id: string) =>
+    (await kit.pool.query("SELECT 1 FROM devices WHERE device_id = $1", [id])).rowCount;
+  const cleanUp = async () => {
+    await deleteTestDevices(kit.pool, ALL); // also the codes those devices have used
+    await kit.pool.query("DELETE FROM claim_codes WHERE name LIKE $1", [`${PREFIX}%`]); // the codes not used yet
+  };
+
+  beforeAll(async () => { kit = await setupTest(); }, 60_000); // the migration may wait for another file's turn
+  beforeEach(() => cleanUp());
+  afterAll(async () => {
+    if (!kit) return; // setupTest() failed: its error was already reported
+    await cleanUp();
+    await kit.close();
+  });
+
+  it("a code exchanged by a device: registered with its key fingerprint, the code recorded as used, the database doesn't store the code", async () => {
+    const code = await createCode(`${PREFIX} 1`);
+    const stored = await kit.pool.query("SELECT code_hash, used_at FROM claim_codes WHERE name = $1", [`${PREFIX} 1`]);
+    expect(stored.rows).toEqual([{ code_hash: codeHash(code), used_at: null }]); // only its fingerprint
+
+    // typed by a human in the portal: lowercase letters and a space are still valid (tidyClaimCode)
+    const answer = await claim(code.toLowerCase().replace("-", " "), NEW_DEVICE);
+    expect(answer.statusCode).toBe(201);
+    const { key } = answer.json() as { key: string };
+
+    const device = await kit.pool.query("SELECT name, key_hash FROM devices WHERE device_id = $1", [NEW_DEVICE]);
+    expect(device.rows).toEqual([{ name: `${PREFIX} 1`, key_hash: createHash("sha256").update(key).digest("hex") }]);
+    const used = await kit.pool.query<{ used_at: Date | null; device_id: string | null }>(
+      "SELECT used_at, device_id FROM claim_codes WHERE name = $1", [`${PREFIX} 1`]);
+    expect(used.rows[0].device_id).toBe(NEW_DEVICE);
+    expect(used.rows[0].used_at).toBeInstanceOf(Date);
+  });
+
+  it("a used code refused with 403; a device that's still active can't be taken over with a new code (409), and that code isn't used up", async () => {
+    const code = await createCode(`${PREFIX} 2`);
+    expect((await claim(code, OWNER)).statusCode).toBe(201);
+
+    const reused = await claim(code, GRABBER); // the same code, another device
+    expect(reused.statusCode).toBe(403);
+    expect(await deviceCount(GRABBER)).toBe(0);
+
+    const newCode = await createCode(`${PREFIX} 2b`);
+    const grab = await claim(newCode, OWNER); // OWNER is still registered and active
+    expect(grab.statusCode).toBe(409);
+    const left = await kit.pool.query("SELECT used_at FROM claim_codes WHERE name = $1", [`${PREFIX} 2b`]);
+    expect(left.rows).toEqual([{ used_at: null }]); // nothing changed: the code can still be used by another device
+  });
+
+  it("an expired code (its time moved back directly in the test database) refused with 403, the device not registered", async () => {
+    const code = await createCode(`${PREFIX} 3`);
+    // as if the code was made 40 minutes ago and ran out 10 minutes ago (CHECK of migration 011: valid for at most 60 minutes)
+    await kit.pool.query("UPDATE claim_codes SET created_at = now() - interval '40 minutes', expires_at = now() - interval '10 minutes' "
+      + "WHERE code_hash = $1", [codeHash(code)]);
+
+    const answer = await claim(code, LATE);
+    expect(answer.statusCode).toBe(403);
+    expect(await deviceCount(LATE)).toBe(0);
+    const list = await kit.app.inject({ method: "GET", url: "/provision/code", cookies: kit.wristband("admin") });
+    expect((list.json() as { name: string | null; state: string }[]).find((c) => c.name === `${PREFIX} 3`))
+      .toMatchObject({ state: "expired" });
+  });
+});
diff --git a/backend/src/integration/devices.test.ts b/backend/src/integration/devices.test.ts
new file mode 100644
index 0000000..96f2e93
--- /dev/null
+++ b/backend/src/integration/devices.test.ts
@@ -0,0 +1,99 @@
+// devices.test.ts - INTEGRATION tests of the device registry (Modules 21 + 28) with a REAL test database (Module 29).
+// The difference with routes/devices.test.ts: there the devices table is replaced by a mock in memory (vi.mock), so the SQL
+// queries in src/db/devices.ts are never run. Here INSERT, UPDATE, transactions, CHECK, and foreign keys are really checked by
+// PostgreSQL. A real example: if src/db/devices.ts one day writes the key fingerprint wrongly (for example upper($5), capitals),
+// the 203 mock tests stay green, but CHECK (key_hash ~ '^[0-9a-f]{64}$') of migration 010 refuses the row: POST /devices
+// is answered with 503 and the first test below is red.
+// Run (the test database running, DATABASE_URL_TEST filled in; see setup.ts): npm run test:integration
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { hasTestDatabase, registerDevice, deleteTestDevices, setupTest } from "./setup.ts";
+import type { TestKit } from "./setup.ts";
+
+// device_ids of this file only (prefix 2901): the other integration test files run at the same time with IDs of their own
+const NEW_DEVICE = "290100000001";
+const DUPLICATE = "290100000002";
+const LISTED = "290100000003";
+const REVOKED = "290100000004";
+const ALL = [NEW_DEVICE, DUPLICATE, LISTED, REVOKED];
+const fingerprint = (key: string) => createHash("sha256").update(key).digest("hex"); // computed here, not by the server code
+// the server version read here from package.json (not from src/config/server-version.ts, which is under test)
+const VERSION = (JSON.parse(readFileSync(new URL("../../package.json", import.meta.url), "utf8")) as { version: string }).version;
+
+describe.skipIf(!hasTestDatabase)("integration (test database): devices", () => {
+  let kit: TestKit;
+  beforeAll(async () => { kit = await setupTest(); }, 60_000); // the migration may wait for another file's turn
+  beforeEach(() => deleteTestDevices(kit.pool, ALL)); // every test starts without this file's devices
+  afterAll(async () => {
+    if (!kit) return; // setupTest() failed (for example the _test guard refused): its error was already reported
+    await deleteTestDevices(kit.pool, ALL);
+    await kit.close();
+  });
+
+  it("POST /devices: the key is shown once, the database stores only its SHA-256 fingerprint (CHECK key_hash)", async () => {
+    const answer = await kit.app.inject({ method: "POST", url: "/devices", cookies: kit.wristband("admin"),
+      payload: { device_id: NEW_DEVICE, name: "Integration test", location: "robot lab" } });
+    expect(answer.statusCode).toBe(201);
+    const { key } = answer.json() as { key: string };
+    expect(key).toMatch(/^[A-Za-z0-9_-]{43}$/);
+
+    // read straight from the table: what is stored is its fingerprint (64 lowercase hexadecimal digits), not the key
+    const result = await kit.pool.query<{ key_hash: string; name: string; registered_at: Date | null }>(
+      "SELECT key_hash, name, registered_at FROM devices WHERE device_id = $1", [NEW_DEVICE]);
+    expect(result.rowCount).toBe(1);
+    expect(result.rows[0].key_hash).toBe(fingerprint(key));
+    expect(result.rows[0].key_hash).not.toContain(key);
+    expect(result.rows[0].name).toBe("Integration test");
+    expect(result.rows[0].registered_at).toBeInstanceOf(Date);
+  });
+
+  it("registering the same device_id again: 409, the name and the key fingerprint in the database don't change", async () => {
+    const key = await registerDevice(kit, DUPLICATE, "Original node");
+    const again = await kit.app.inject({ method: "POST", url: "/devices", cookies: kit.wristband("admin"),
+      payload: { device_id: DUPLICATE, name: "Intruder node" } });
+    expect(again.statusCode).toBe(409);
+
+    // ON CONFLICT ... WHERE registered_at IS NULL: a row that is already registered must not be overwritten
+    const result = await kit.pool.query("SELECT name, key_hash FROM devices WHERE device_id = $1", [DUPLICATE]);
+    expect(result.rows).toEqual([{ name: "Original node", key_hash: fingerprint(key) }]);
+  });
+
+  it("GET /devices from the database without leaking the key; without a login 401; /health names the version and the database", async () => {
+    const key = await registerDevice(kit, LISTED, "Listed node");
+    const answer = await kit.app.inject({ method: "GET", url: "/devices", cookies: kit.wristband("viewer") }); // a viewer may look
+    expect(answer.statusCode).toBe(200);
+
+    const list = answer.json() as { device_id: string; name: string | null; key: string }[];
+    expect(list.find((d) => d.device_id === LISTED)).toMatchObject({ name: "Listed node", key: "active" });
+    expect(answer.body).not.toContain(key);
+    expect(answer.body).not.toContain(fingerprint(key));
+    expect(answer.body).not.toContain("key_hash");
+
+    // the production assembly (buildApp) is guarded too: the login guard is in place, and /health (the version proof on the
+    // VPS/Pi) names the package.json version and the connected database
+    expect((await kit.app.inject({ method: "GET", url: "/devices" })).statusCode).toBe(401);
+    const health = await kit.app.inject({ method: "GET", url: "/health" });
+    expect(health.statusCode).toBe(200);
+    expect(health.json()).toMatchObject({ ok: true, version: VERSION, database: true });
+  });
+
+  it("revoke (Deactivate): the key fingerprint deleted, the revoke time and the status offline written, the event in the events table", async () => {
+    await registerDevice(kit, REVOKED);
+    const answer = await kit.app.inject({ method: "POST", url: `/devices/${REVOKED}/revoke`, cookies: kit.wristband("admin") });
+    expect(answer.statusCode).toBe(200);
+
+    const result = await kit.pool.query<{ key_hash: string | null; revoked_at: Date | null; status: string }>(
+      "SELECT key_hash, revoked_at, status FROM devices WHERE device_id = $1", [REVOKED]);
+    expect(result.rows[0]).toMatchObject({ key_hash: null, status: "offline" });
+    expect(result.rows[0].revoked_at).toBeInstanceOf(Date);
+    // the event log is written by the route without waiting (recordEvent), so its row is waited for briefly (at most 1 second)
+    await vi.waitFor(async () => {
+      const events = await kit.pool.query("SELECT kind, source FROM events WHERE device_id = $1", [REVOKED]);
+      expect(events.rows).toEqual([{ kind: "revoked", source: "api" }]);
+    });
+
+    const again = await kit.app.inject({ method: "POST", url: `/devices/${REVOKED}/revoke`, cookies: kit.wristband("admin") });
+    expect(again.statusCode).toBe(404); // already revoked: nothing changes any more
+  });
+});
diff --git a/backend/src/integration/firmware-fleet.test.ts b/backend/src/integration/firmware-fleet.test.ts
new file mode 100644
index 0000000..4213e39
--- /dev/null
+++ b/backend/src/integration/firmware-fleet.test.ts
@@ -0,0 +1,115 @@
+// firmware-fleet.test.ts - INTEGRATION tests of the firmware releases and the /fleet page (Module 28) with a REAL test database
+// and a temporary firmware folder (Module 29). What mocks can't test: a release's metadata in the firmware table (PRIMARY KEY
+// kind + version: a version can't be overwritten), the locked download matching the device key with the fingerprint in devices,
+// the test-release and withdrawn marks, and the LATERAL query of the /fleet page (the LATEST health and last update per device).
+// The .bin files here are fake: 4 KiB of random bytes with a first byte 0xE9 (the server only checks that byte and the size).
+// Run (the test database running, DATABASE_URL_TEST filled in; see setup.ts): npm run test:integration
+import { createHash, randomBytes } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { hasTestDatabase, registerDevice, deleteTestDevices, setupTest } from "./setup.ts";
+import type { TestKit } from "./setup.ts";
+
+// device_ids and firmware versions of this file only (prefix 2906 and 29.6.x)
+const DOWNLOADER = "290600000001";
+const MEMBER = "290600000002";
+const ALL = [DOWNLOADER, MEMBER];
+const sha256 = (content: Buffer) => createHash("sha256").update(content).digest("hex");
+
+function fakeBin(): Buffer {
+  const content = randomBytes(4096);
+  content[0] = 0xe9; // the mark of an ESP32 application image
+  return content;
+}
+
+describe.skipIf(!hasTestDatabase)("integration (test database): firmware releases and the fleet", () => {
+  let kit: TestKit;
+  const upload = (version: string, content: Buffer, testRelease = false) => kit.app.inject({ method: "POST",
+    url: `/firmware/node1/${version}${testRelease ? "?test=true" : ""}`, cookies: kit.wristband("admin"),
+    headers: { "content-type": "application/octet-stream" }, payload: content });
+  const cleanUp = async () => {
+    await deleteTestDevices(kit.pool, ALL); // also the update rows that point at the releases below
+    await kit.pool.query("DELETE FROM firmware WHERE version LIKE '29.6.%'");
+  };
+
+  beforeAll(async () => { kit = await setupTest(); }, 60_000); // the migration may wait for another file's turn
+  beforeEach(async () => {
+    await cleanUp();
+    // Two tests below judge "the latest release" from ALL rows of the firmware table: another release in the test database (for
+    // example left over from trying a firmware upload) makes the result wrong. Stop with a clear message, not a confusing AssertionError.
+    const others = await kit.pool.query<{ version: string }>("SELECT version FROM firmware WHERE version NOT LIKE '29.6.%'");
+    if (others.rowCount) {
+      throw new Error(`the firmware table in the test database holds other releases (${others.rows.map((r) => r.version).join(", ")}): `
+        + "this test needs a firmware table without other releases. Use a fresh test database (restart its container).");
+    }
+  });
+  afterAll(async () => {
+    if (!kit) return; // setupTest() failed: its error was already reported
+    await cleanUp();
+    await kit.close();
+  });
+
+  it("upload: the metadata (size, the server's SHA-256) stored, a version can't be overwritten, a device downloads with its key", async () => {
+    const content = fakeBin();
+    expect((await upload("29.6.1", content)).statusCode).toBe(201);
+    const result = await kit.pool.query("SELECT size, sha256, test, uploaded_by, withdrawn_at FROM firmware WHERE version = '29.6.1'");
+    expect(result.rows).toEqual([{ size: 4096, sha256: sha256(content), test: false, uploaded_by: "1", withdrawn_at: null }]);
+    expect((await readFile(join(kit.firmwareFolder, "node-1", "29.6.1.bin"))).equals(content)).toBe(true); // the file in the cupboard
+    expect((await upload("29.6.1", fakeBin())).statusCode).toBe(409); // other content, the same version: refused
+
+    // the device download: Basic Auth device_id:key (matched with the fingerprint in the devices table) + its WiFi MAC
+    const key = await registerDevice(kit, DOWNLOADER);
+    const download = (keySent: string) => kit.app.inject({ method: "GET", url: "/fw/node-1/29.6.1.bin", headers: {
+      authorization: `Basic ${Buffer.from(`${DOWNLOADER}:${keySent}`).toString("base64")}`,
+      "x-esp32-sta-mac": "29:06:00:00:00:01" } });
+    const succeeded = await download(key);
+    expect(succeeded.statusCode).toBe(200);
+    expect(succeeded.headers["x-sha256"]).toBe(sha256(content));
+    expect(succeeded.rawPayload.equals(content)).toBe(true);
+    const wrongKey = key.slice(0, -1) + (key.endsWith("A") ? "B" : "A"); // the last character replaced: one character different
+    expect((await download(wrongKey)).statusCode).toBe(403);
+  });
+
+  it("a test release is stored marked test and never becomes the latest release; a withdrawn release leaves the count", async () => {
+    expect((await upload("29.6.2", fakeBin())).statusCode).toBe(201);
+    expect((await upload("29.6.3", fakeBin(), true)).statusCode).toBe(201); // higher, but a TEST release
+    const flags = await kit.pool.query("SELECT version, test FROM firmware WHERE version LIKE '29.6.%' ORDER BY version");
+    expect(flags.rows).toEqual([{ version: "29.6.2", test: false }, { version: "29.6.3", test: true }]);
+
+    type ReleaseList = { latest: { node1: string | null }; releases: { version: string; can_update_all: boolean; update_all_reason: string | null }[] };
+    const list = async () => (await kit.app.inject({ method: "GET", url: "/firmware", cookies: kit.wristband("viewer") })).json() as ReleaseList;
+    const before = await list();
+    expect(before.latest.node1).toBe("29.6.2");
+    expect(before.releases.find((r) => r.version === "29.6.3"))
+      .toMatchObject({ can_update_all: false, update_all_reason: "test release: per device only" });
+
+    const withdraw = await kit.app.inject({ method: "POST", url: "/firmware/node1/29.6.2/withdraw", cookies: kit.wristband("admin") });
+    expect(withdraw.statusCode).toBe(200);
+    const withdrawn = await kit.pool.query<{ withdrawn_at: Date | null }>("SELECT withdrawn_at FROM firmware WHERE version = '29.6.2'");
+    expect(withdrawn.rows[0].withdrawn_at).toBeInstanceOf(Date);
+    expect((await list()).latest.node1).toBeNull(); // only the test release is left: no latest release
+  });
+
+  it("GET /fleet: a device shows with its LATEST health and its last update (LATERAL), needs_update from the latest release", async () => {
+    await registerDevice(kit, MEMBER, "Test fleet node");
+    // as if the device has been running: it reported version 29.5.0, sent vitals twice, and once failed to install 29.6.4
+    await kit.pool.query("UPDATE devices SET kind = 'node1', fw = '29.5.0', fw_seen_at = now() WHERE device_id = $1", [MEMBER]);
+    await kit.pool.query(`INSERT INTO device_health (device_id, ts, rssi, uptime_s, heap_free, reset_reason, fw) VALUES
+      ($1, now() - interval '20 minutes', -70, 600, 150000, 'POWERON', '29.5.0'),
+      ($1, now() - interval '2 minutes', -55, 1680, 148000, 'POWERON', '29.5.0')`, [MEMBER]);
+    expect((await upload("29.6.4", fakeBin())).statusCode).toBe(201);
+    await kit.pool.query(`INSERT INTO updates (id, device_id, from_version, to_version, status, message, finished_at)
+      VALUES ('c-test-290600000002', $1, '29.5.0', '29.6.4', 'rollback', 'trial period failed', now())`, [MEMBER]);
+
+    const answer = await kit.app.inject({ method: "GET", url: "/fleet", cookies: kit.wristband("viewer") });
+    expect(answer.statusCode).toBe(200);
+    const body = answer.json() as { latest_release: { node1: string | null }; devices: { device_id: string }[] };
+    expect(body.latest_release.node1).toBe("29.6.4");
+    expect(body.devices.find((d) => d.device_id === MEMBER)).toMatchObject({
+      name: "Test fleet node", key: "active", fw: "29.5.0", needs_update: true,
+      health: { rssi: -55, uptime_s: 1680, reset_reason: "POWERON" }, // the row of 2 minutes ago, not of 20 minutes ago
+      update: { status: "rollback", from: "29.5.0", to: "29.6.4", message: "trial period failed" },
+    });
+  });
+});
diff --git a/backend/src/integration/login.test.ts b/backend/src/integration/login.test.ts
new file mode 100644
index 0000000..c596b3e
--- /dev/null
+++ b/backend/src/integration/login.test.ts
@@ -0,0 +1,92 @@
+// login.test.ts - INTEGRATION tests of the login (Module 20) with REAL users and sessions tables (Module 29).
+// What mocks can't test: bcrypt matching a password with the stored fingerprint, a session (refresh token) stored only as its
+// SHA-256, the refresh rotation in ONE UPDATE statement, and a logout that really deletes its row.
+// Run (the test database running, DATABASE_URL_TEST filled in; see setup.ts): npm run test:integration
+import { createHash } from "node:crypto";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { hasTestDatabase, setupTest } from "./setup.ts";
+import type { TestKit } from "./setup.ts";
+
+// an account of this file only; the .test domain is reserved for testing (it never exists on the internet)
+const EMAIL = "integration-test-login@home.test";
+const PASSWORD = "a passphrase only for the integration tests";
+const sha256 = (text: string) => createHash("sha256").update(text).digest("hex");
+
+// one cookie from an answer (light-my-request has already read its Set-Cookie headers)
+function cookie(answer: { cookies: { name: string; value: string }[] }, name: string): string {
+  const found = answer.cookies.find((c) => c.name === name);
+  if (found === undefined) throw new Error(`cookie ${name} isn't in the answer`);
+  return found.value;
+}
+
+describe.skipIf(!hasTestDatabase)("integration (test database): login, refresh, logout", () => {
+  let kit: TestKit;
+  let passwordHash = ""; // the bcrypt fingerprint of PASSWORD, made once (bcrypt is slow on purpose: ±0.3 seconds)
+  const logIn = (email: string, password: string) => kit.app.inject({ method: "POST", url: "/auth/login", payload: { email, password } });
+  const accountSessions = () => kit.pool.query<{ token_hash: string; previous_token_hash: string | null }>(
+    "SELECT s.token_hash, s.previous_token_hash FROM sessions s JOIN users u ON u.id = s.user_id WHERE u.email = $1", [EMAIL]);
+
+  beforeAll(async () => {
+    kit = await setupTest();
+    const { makeFingerprint } = await import("../auth/password.ts"); // the same function as npm run users (cost 12)
+    passwordHash = await makeFingerprint(PASSWORD);
+  }, 60_000);
+  beforeEach(async () => { // a new account for every test; its old sessions are deleted with it (ON DELETE CASCADE)
+    await kit.pool.query("DELETE FROM users WHERE email = $1", [EMAIL]);
+    await kit.pool.query(
+      "INSERT INTO users (email, name, role, password_hash, password_changed_at) VALUES ($1, 'Login Test', 'viewer', $2, now())",
+      [EMAIL, passwordHash]);
+  });
+  afterAll(async () => {
+    if (!kit) return; // setupTest() failed: its error was already reported
+    await kit.pool.query("DELETE FROM users WHERE email = $1", [EMAIL]);
+    await kit.close();
+  });
+
+  it("the right password: two httpOnly cookies, the session stored in the database only as the refresh token's SHA-256", async () => {
+    const answer = await logIn(EMAIL, PASSWORD);
+    expect(answer.statusCode).toBe(200);
+    expect(answer.json()).toMatchObject({ email: EMAIL, role: "viewer" });
+    expect(answer.cookies.find((c) => c.name === "access")).toMatchObject({ httpOnly: true, path: "/" });
+    expect(answer.cookies.find((c) => c.name === "session")).toMatchObject({ httpOnly: true, path: "/auth" });
+
+    const session = await accountSessions();
+    expect(session.rows).toEqual([{ token_hash: sha256(cookie(answer, "session")), previous_token_hash: null }]);
+    // the wristband from this login opens the routes with a padlock: /auth/me reads its account from the database
+    const me = await kit.app.inject({ method: "GET", url: "/auth/me", cookies: { access: cookie(answer, "access") } });
+    expect(me.json()).toMatchObject({ email: EMAIL, name: "Login Test" });
+  });
+
+  it("a wrong password and an unregistered email: the same 401, no cookie and no new session", async () => {
+    const wrong = await logIn(EMAIL, "not this account's password at all");
+    const unknown = await logIn("not-registered@home.test", PASSWORD);
+    expect(wrong.statusCode).toBe(401);
+    expect(unknown.statusCode).toBe(401);
+    expect(unknown.json()).toEqual(wrong.json()); // the same answer: a guesser can't tell which email is registered
+    expect(wrong.cookies).toEqual([]);
+    expect((await accountSessions()).rowCount).toBe(0);
+  });
+
+  it("refresh: the session cookie swapped for a new one (rotation); the database stores the fingerprints of the new and the old token", async () => {
+    const login = await logIn(EMAIL, PASSWORD);
+    const oldSession = cookie(login, "session");
+    const refreshed = await kit.app.inject({ method: "POST", url: "/auth/refresh", cookies: { session: oldSession } });
+    expect(refreshed.statusCode).toBe(200);
+
+    const newSession = cookie(refreshed, "session");
+    expect(newSession).not.toBe(oldSession);
+    expect((await accountSessions()).rows).toEqual([{ token_hash: sha256(newSession), previous_token_hash: sha256(oldSession) }]);
+  });
+
+  it("logout: the session row deleted, both cookies emptied, the old session cookie can't refresh again", async () => {
+    const session = cookie(await logIn(EMAIL, PASSWORD), "session");
+    const loggedOut = await kit.app.inject({ method: "POST", url: "/auth/logout", cookies: { session } });
+    expect(loggedOut.statusCode).toBe(200);
+    expect(cookie(loggedOut, "access")).toBe("");
+    expect(cookie(loggedOut, "session")).toBe("");
+    expect((await accountSessions()).rowCount).toBe(0);
+
+    const again = await kit.app.inject({ method: "POST", url: "/auth/refresh", cookies: { session } });
+    expect(again.statusCode).toBe(401);
+  });
+});
diff --git a/backend/src/integration/readings.test.ts b/backend/src/integration/readings.test.ts
new file mode 100644
index 0000000..30ab46c
--- /dev/null
+++ b/backend/src/integration/readings.test.ts
@@ -0,0 +1,89 @@
+// readings.test.ts - INTEGRATION tests of the reading history (Modules 17-18) in a REAL TimescaleDB readings hypertable (Module 29).
+// What mock tables can't test: the order and the time limits from SQL (ORDER BY ts, ts >= ... AND ts < ...), TimescaleDB's
+// time_bucket() function for the 15-minute summary, and PRIMARY KEY (device_id, ts) + ON CONFLICT DO NOTHING, which throws
+// away a double delivery.
+// Run (the test database running, DATABASE_URL_TEST filled in; see setup.ts): npm run test:integration
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { hasTestDatabase, deleteTestDevices, setupTest } from "./setup.ts";
+import type { TestKit } from "./setup.ts";
+
+// device_ids of this file only (prefix 2902)
+const ONE = "290200000001";
+const NEIGHBOR = "290200000002";
+const DUPLICATE = "290200000003";
+const ALL = [ONE, NEIGHBOR, DUPLICATE];
+const MINUTE = 60_000;
+
+describe.skipIf(!hasTestDatabase)("integration (test database): reading history", () => {
+  let kit: TestKit;
+  // a reading only needs its device in the devices table (foreign key readings -> devices); no registration through the API
+  const ensureDevice = (id: string) => kit.pool.query("INSERT INTO devices (device_id) VALUES ($1)", [id]);
+  const saveReading = (id: string, ts: Date, temperature: number) =>
+    kit.pool.query("INSERT INTO readings (device_id, ts, fw, temperature, humidity) VALUES ($1, $2, '1.7.0', $3, 60)", [id, ts, temperature]);
+
+  beforeAll(async () => { kit = await setupTest(); }, 60_000); // the migration may wait for another file's turn
+  beforeEach(() => deleteTestDevices(kit.pool, ALL));
+  afterAll(async () => {
+    if (!kit) return; // setupTest() failed: its error was already reported
+    await deleteTestDevices(kit.pool, ALL);
+    await kit.close();
+  });
+
+  it("GET /devices/:id/readings: only the readings of the last hour, in time order (oldest first)", async () => {
+    await ensureDevice(ONE);
+    const now = Date.now();
+    // saved in a RANDOM order: the order in the answer must come from ORDER BY ts, not from the order of saving
+    await saveReading(ONE, new Date(now - 10 * MINUTE), 23.5);
+    await saveReading(ONE, new Date(now - 50 * MINUTE), 21.5);
+    await saveReading(ONE, new Date(now - 30 * MINUTE), 22.5);
+    await saveReading(ONE, new Date(now - 180 * MINUTE), 99); // 3 hours ago: outside the default range (1 hour)
+
+    const answer = await kit.app.inject({ method: "GET", url: `/devices/${ONE}/readings`, cookies: kit.wristband("viewer") });
+    expect(answer.statusCode).toBe(200);
+    const body = answer.json() as { count: number; truncated: boolean; readings: { temperature: number | null }[] };
+    expect(body.count).toBe(3);
+    expect(body.truncated).toBe(false);
+    expect(body.readings.map((r) => r.temperature)).toEqual([21.5, 22.5, 23.5]);
+  });
+
+  it("a 15-minute summary (TimescaleDB time_bucket): only that device's readings are counted", async () => {
+    await ensureDevice(ONE);
+    await ensureDevice(NEIGHBOR);
+    // the start of one 15-minute bucket, two hours ago (rounded down to a multiple of 15 minutes)
+    const start = Math.floor((Date.now() - 120 * MINUTE) / (15 * MINUTE)) * (15 * MINUTE);
+    await saveReading(ONE, new Date(start + 1 * MINUTE), 20);
+    await saveReading(ONE, new Date(start + 4 * MINUTE), 22);
+    await saveReading(ONE, new Date(start + 7 * MINUTE), 24);
+    await saveReading(NEIGHBOR, new Date(start + 2 * MINUTE), 90); // another device in the same bucket: must not count
+    await saveReading(NEIGHBOR, new Date(start + 5 * MINUTE), 95);
+
+    const range = new URLSearchParams({ bucket: "15m", from: new Date(start).toISOString(),
+      to: new Date(start + 15 * MINUTE).toISOString() });
+    const answer = await kit.app.inject({ method: "GET", url: `/devices/${ONE}/readings?${range}`,
+      cookies: kit.wristband("viewer") });
+    expect(answer.statusCode).toBe(200);
+    const body = answer.json() as { summary: Record<string, unknown>[] };
+    expect(body.summary).toEqual([{
+      time: new Date(start).toISOString().slice(0, 19) + "Z", // the contract format: UTC without milliseconds
+      avg_temp: 22, min_temp: 20, max_temp: 24, avg_humidity: 60, avg_soil: null, avg_light: null, reading_count: 3,
+    }]);
+  });
+
+  it("a double delivery: the same telemetry twice (same ts) is stored as one row (PRIMARY KEY + ON CONFLICT)", async () => {
+    await ensureDevice(DUPLICATE);
+    // the function mqtt.ts calls for every telemetry that passes the contract (imported after setupTest filled in the settings)
+    const { archiveTelemetry } = await import("../db/archive.ts");
+    const telemetry = { ts: new Date(Date.now() - 5 * MINUTE).toISOString().slice(0, 19) + "Z", fw: "1.7.0", temperature: 27.5,
+      humidity: 61, light: 900, soil: 40, motion: false, water_level: 80 };
+
+    expect(await archiveTelemetry(DUPLICATE, telemetry)).toBe(true); // first: stored
+    expect(await archiveTelemetry(DUPLICATE, telemetry)).toBe(false); // second (QoS 1 may send it again): skipped, no error
+    const result = await kit.pool.query("SELECT temperature, humidity, light FROM readings WHERE device_id = $1", [DUPLICATE]);
+    expect(result.rows).toEqual([{ temperature: 27.5, humidity: 61, light: 900 }]);
+    // the telemetry also updates its device row: the kind is recognized from its content, the last-seen time is filled in
+    const device = await kit.pool.query<{ kind: string; last_seen: Date | null }>(
+      "SELECT kind, last_seen FROM devices WHERE device_id = $1", [DUPLICATE]);
+    expect(device.rows[0].kind).toBe("node1");
+    expect(device.rows[0].last_seen).toBeInstanceOf(Date);
