      "pluginVersion": "13.2.4",
      "targets": [
        {
          "dataset": "smarthome",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smarthome-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.device_id, coalesce(d.name, d.device_id) AS node,\n       round((EXTRACT(EPOCH FROM now() - coalesce(r.received_at, d.registered_at)) / 60\n              - CASE WHEN d.kind = 'node2' THEN 5 ELSE 0 END)::numeric, 1)::float8 AS minutes_late\nFROM devices d\nLEFT JOIN LATERAL (SELECT received_at FROM readings WHERE device_id = d.device_id ORDER BY ts DESC LIMIT 1) r ON true\nWHERE d.registered_at IS NOT NULL AND d.revoked_at IS NULL",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Minutes behind schedule",
      "type": "table"
    }
