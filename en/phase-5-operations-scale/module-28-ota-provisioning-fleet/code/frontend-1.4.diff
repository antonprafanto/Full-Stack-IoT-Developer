diff --git a/frontend/src/components/ReleaseList.tsx b/frontend/src/components/ReleaseList.tsx
new file mode 100644
index 0000000..c58dd78
--- /dev/null
+++ b/frontend/src/components/ReleaseList.tsx
@@ -0,0 +1,148 @@
+// ReleaseList.tsx - the firmware releases stored on the server (GET /firmware, Module 28): version, size, SHA-256, notes, and
+// its canary summary. An admin gets two buttons per release: "Update canary" (the devices marked canary first), then
+// "Update all", which only opens after at least one canary SUCCEEDED with that version (the server
+// decides: can_update_all). Test releases and withdrawn releases have no buttons: a test release only goes through Update on the
+// card of one device.
+import { useState } from "react";
+import { updateMany } from "../api";
+import { errorMessage, sizeText } from "../fleet";
+import { toast } from "../toast";
+import type { ReleaseList as List, FleetResult, FullRelease } from "../types";
+import { wibDateTime } from "../time";
+import ErrorBox from "./ErrorBox";
+import ConfirmButton from "./ConfirmButton";
+
+const SHAPE = "rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap";
+
+// the sentence for one device that was sent the command
+const SEND_TEXT: Record<string, string> = {
+  accepted: "accepted the command",
+  "no-ack": "didn't answer within 5 seconds",
+  rejected: "refused",
+  "not-sent": "not sent",
+};
+
+function ReleaseCard({ r, latest, admin, onChange }: { r: FullRelease; latest: boolean; admin: boolean; onChange: () => void }) {
+  const [result, setResult] = useState<FleetResult | null>(null); // the last "Update canary/all" result for this release
+  const [error, setError] = useState<string | null>(null); // the last error, shown until Close (ErrorBox)
+
+  async function send(target: "canary" | "all") {
+    try {
+      const out = await updateMany(r.version, target);
+      setResult(out);
+      setError(null);
+      toast(
+        "Command " + r.version + " sent to " + out.sent.length + " device(s)" + (out.skipped.length > 0 ? ", " + out.skipped.length + " skipped." : "."),
+        out.sent.length > 0 ? "success" : "info",
+      );
+      onChange();
+    } catch (err) {
+      setError(errorMessage(err, "The update command couldn't be sent."));
+    }
+  }
+
+  return (
+    <li className="min-w-0 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
+      <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+        <span className="font-mono font-semibold text-slate-800 dark:text-slate-100">Node 1 {r.version}</span>
+        {latest ? <span className={SHAPE + " bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-100"}>latest</span> : null}
+        {r.test ? <span className={SHAPE + " bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100"}>test</span> : null}
+        {r.withdrawn_at !== null ? <span className={SHAPE + " bg-red-600 text-white"}>withdrawn</span> : null}
+      </div>
+      {r.notes !== null ? <p className="mt-1 text-sm break-words text-slate-700 dark:text-slate-200">{r.notes}</p> : null}
+      <p className="mt-1 text-sm text-slate-600 dark:text-slate-400">
+        {sizeText(r.size)} · uploaded {wibDateTime(Date.parse(r.created_at))}
+      </p>
+      {/* break-all: 64 hexadecimal digits without spaces still wrap on a phone screen */}
+      <p className="mt-1 font-mono text-xs break-all text-slate-600 dark:text-slate-400">sha256 {r.sha256}</p>
+      {!r.test ? (
+        <p className="mt-1 text-sm text-slate-700 dark:text-slate-200">
+          Canary: {r.canary_succeeded} succeeded, {r.canary_failed} failed or rolled back
+        </p>
+      ) : null}
+
+      {admin && !r.test && r.withdrawn_at === null ? (
+        <div className="mt-3 flex flex-wrap items-start gap-3">
+          <ConfirmButton
+            label="Update canary"
+            title={"Update all canary devices to " + r.version + "?"}
+            yesLabel="Yes, update the canary"
+            onYes={() => send("canary")}
+          >
+            <p>
+              Only the online Node 1s marked canary. Devices that are offline, already updating, or already running {r.version}{" "}
+              are skipped, not queued.
+            </p>
+          </ConfirmButton>
+          <ConfirmButton
+            label="Update all"
+            title={"Update ALL Node 1s to " + r.version + "?"}
+            yesLabel="Yes, update all"
+            onYes={() => send("all")}
+            disabledReason={r.can_update_all ? null : "Locked: " + (r.update_all_reason ?? "conditions not met yet") + "."}
+          >
+            <p>
+              Every online Node 1 that meets the conditions gets the command at once. Those offline or already updating are skipped,
+              not queued: update again later.
+            </p>
+          </ConfirmButton>
+        </div>
+      ) : null}
+
+      <ErrorBox message={error} onClose={() => setError(null)} />
+
+      {result !== null ? (
+        <div role="status" className="mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-800 dark:bg-slate-900 dark:text-slate-200">
+          <p className="font-medium">
+            Update {result.target} to {result.version}: {result.sent.length} sent, {result.skipped.length} skipped
+          </p>
+          <ul className="mt-1 space-y-0.5 break-words">
+            {result.sent.map((s) => (
+              <li key={s.device_id}>
+                <span className="font-mono">{s.device_id}</span> {SEND_TEXT[s.status] ?? s.status}
+                {s.message === undefined ? "" : ": " + s.message}
+              </li>
+            ))}
+            {result.skipped.map((s) => (
+              <li key={s.device_id} className="text-slate-600 dark:text-slate-400">
+                <span className="font-mono">{s.device_id}</span> skipped: {s.reason}
+              </li>
+            ))}
+          </ul>
+          <button
+            type="button"
+            onClick={() => setResult(null)}
+            className="mt-2 min-h-11 rounded-lg border border-slate-300 px-4 hover:bg-white dark:border-slate-600 dark:hover:bg-slate-800"
+          >
+            Close
+          </button>
+        </div>
+      ) : null}
+    </li>
+  );
+}
+
+type Props = {
+  list: List;
+  admin: boolean;
+  onChange: () => void;
+};
+
+export default function ReleaseList({ list, admin, onChange }: Props) {
+  if (list.releases.length === 0) {
+    return (
+      <p className="rounded-lg bg-white p-3 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
+        No firmware uploaded to the server yet.
+      </p>
+    );
+  }
+  // newest on top: the server sends them in upload order (old to new); [...] = a copy, the original array isn't changed
+  const newestFirst = [...list.releases].reverse();
+  return (
+    <ul className="grid gap-3">
+      {newestFirst.map((r) => (
+        <ReleaseCard key={r.version} r={r} latest={r.version === list.latest.node1} admin={admin} onChange={onChange} />
+      ))}
+    </ul>
+  );
+}
diff --git a/frontend/src/components/UpdateHistory.tsx b/frontend/src/components/UpdateHistory.tsx
new file mode 100644
index 0000000..8dbd454
--- /dev/null
+++ b/frontend/src/components/UpdateHistory.tsx
@@ -0,0 +1,74 @@
+// UpdateHistory.tsx - the firmware update history of one device (GET /devices/:id/updates, Module 28), inside a Fleet
+// card. Closed by default (<details>), and only fetched from the server when it is opened: a Fleet screen with many
+// devices doesn't need to ask for all their histories at once.
+import { useEffect, useState } from "react";
+import { getUpdateHistory, ApiError } from "../api";
+import { UPDATE_TEXT } from "../fleet";
+import { handleSessionExpired } from "../store";
+import type { Update } from "../types";
+import { wibDateTime } from "../time";
+
+type Props = {
+  deviceId: string;
+  version: string; // changes every time the last update changes: a history that is open is fetched again
+};
+
+export default function UpdateHistory({ deviceId, version }: Props) {
+  const [open, setOpen] = useState(false);
+  const [history, setHistory] = useState<Update[] | null>(null); // null = not loaded yet
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!open) return; // closed: asks for nothing
+    let ignore = false;
+    getUpdateHistory(deviceId)
+      .then((list) => {
+        if (ignore) return;
+        setHistory(list);
+        setError(null);
+      })
+      .catch((err) => {
+        if (ignore) return;
+        if (err instanceof ApiError && err.code === 401) return handleSessionExpired();
+        setError(err instanceof ApiError ? err.message : "Couldn't load the update history.");
+      });
+    return () => {
+      ignore = true;
+    };
+  }, [open, deviceId, version]);
+
+  let content;
+  if (error !== null) content = <p className="text-red-700 dark:text-red-300">{error}</p>;
+  else if (history === null) content = <p className="text-slate-600 dark:text-slate-400">Loading the history…</p>;
+  else if (history.length === 0) content = <p className="text-slate-600 dark:text-slate-400">Never updated over the air.</p>;
+  else {
+    content = (
+      <ol className="space-y-1">
+        {history.map((u) => (
+          <li key={u.id} className="break-words">
+            <span className="font-mono">
+              {u.from ?? "?"} → {u.to}
+            </span>{" "}
+            <span className="font-medium">{UPDATE_TEXT[u.status].text}</span>
+            <span className="text-slate-600 dark:text-slate-400">
+              {" "}
+              · {wibDateTime(Date.parse(u.created_at))}
+              {u.message !== null ? " · " + u.message : ""}
+            </span>
+          </li>
+        ))}
+      </ol>
+    );
+  }
+
+  return (
+    // onToggle: the browser calls it every time the <details> opens or closes
+    <details className="mt-2 text-sm" onToggle={(e) => setOpen(e.currentTarget.open)}>
+      {/* py-3: about 44 px high, easy to tap with a thumb (no flex, so the browser's own open/close triangle still shows) */}
+      <summary className="cursor-pointer py-3 font-medium text-teal-700 dark:text-teal-300">
+        Update history
+      </summary>
+      <div className="mt-1 rounded-lg bg-slate-50 p-2 text-slate-800 dark:bg-slate-900 dark:text-slate-200">{content}</div>
+    </details>
+  );
+}
diff --git a/frontend/src/fleet.ts b/frontend/src/fleet.ts
new file mode 100644
index 0000000..1025800
--- /dev/null
+++ b/frontend/src/fleet.ts
@@ -0,0 +1,117 @@
+// fleet.ts - helpers of the Fleet screen (Module 28): texts and colors for the update statuses and the restart reasons, how to
+// write a file size, the Wi-Fi signal, RAM, and uptime, and why the Update button can't be used yet.
+// It holds ordinary functions and tables (not components), so the device card and the release list stay short.
+import { ApiError } from "./api";
+import { toast } from "./toast";
+import { handleSessionExpired } from "./store";
+import type { FleetRow, Update, ResetReason, UpdateStatus, DeviceStatus } from "./types";
+
+// One program shelf (app0 or app1) of the Minimal SPIFFS scheme (Module 10): 0x1E0000 = 1,966,080 bytes. A bigger firmware
+// file doesn't fit the spare shelf, so the backend refuses it (400); this screen refuses it first, before it is uploaded.
+export const PROGRAM_SHELF = 1_966_080;
+
+// The Tailwind classes are written WHOLE (not joined), as in Badge.tsx: Tailwind only makes classes that are written in full.
+const BLUE = "bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-100";
+const GREEN = "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-100";
+const YELLOW = "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100";
+const RED = "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-100";
+const GRAY = "bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200";
+
+// Update statuses: a color ALWAYS comes with text (still readable for people who find colors hard to tell apart).
+export const UPDATE_TEXT: Record<UpdateStatus, { text: string; color: string }> = {
+  sent: { text: "sent, waiting for the device", color: BLUE },
+  accepted: { text: "accepted by the device", color: BLUE }, // ack = the command ACCEPTED, not finished yet
+  downloading: { text: "downloading", color: BLUE },
+  succeeded: { text: "succeeded", color: GREEN },
+  rollback: { text: "back to the old version (rollback)", color: YELLOW }, // the new firmware failed, the device is safe
+  failed: { text: "failed", color: RED },
+  rejected: { text: "rejected by the device", color: YELLOW },
+  expired: { text: "expired (no word)", color: GRAY },
+};
+
+// the three statuses that mean "still running": meanwhile a second update command for the same device is refused (409)
+export function inProgress(u: Update | null): boolean {
+  return u !== null && (u.status === "sent" || u.status === "accepted" || u.status === "downloading");
+}
+
+// Why the device started the last time (contract 1.6 section 6). Red = something is wrong in the firmware; yellow = the power supply.
+export const RESET_MEANINGS: Record<ResetReason, { meaning: string; color: string }> = {
+  POWERON: { meaning: "power just came on or the EN button", color: GRAY },
+  BROWNOUT: { meaning: "the voltage dipped: check the power supply", color: YELLOW },
+  SW: { meaning: "restarted by the program (update, rollback, restart)", color: BLUE },
+  PANIC: { meaning: "the program crashed", color: RED },
+  WDT: { meaning: "the program got stuck (watchdog)", color: RED },
+  DEEPSLEEP: { meaning: "woke up from deep sleep", color: GRAY },
+  UNKNOWN: { meaning: "another reason", color: GRAY },
+};
+
+const NUMBER = new Intl.NumberFormat("en-US"); // 1234567 -> "1,234,567"
+
+// "1,234,567 bytes (63% of a shelf)": a firmware file's size compared with one program shelf
+export function sizeText(bytes: number): string {
+  return NUMBER.format(bytes) + " bytes (" + Math.round((bytes / PROGRAM_SHELF) * 100) + "% of a shelf)";
+}
+
+// the Wi-Fi signal strength, with the categories of the Module 10 RSSI table (Concept 2)
+export function signalText(rssi: number): string {
+  let category = "very weak";
+  if (rssi >= -55) category = "very strong";
+  else if (rssi >= -67) category = "strong";
+  else if (rssi >= -75) category = "fair";
+  else if (rssi >= -85) category = "weak";
+  return rssi + " dBm (" + category + ")";
+}
+
+// free RAM: bytes -> KB (1 KB = 1,024 bytes, the way ESP-IDF counts)
+export function ramText(bytes: number): string {
+  return NUMBER.format(Math.round(bytes / 1024)) + " KB free";
+}
+
+// uptime: 93784 seconds -> "1 d 2 h"; only the two biggest units, to keep it short
+export function uptimeText(seconds: number): string {
+  const days = Math.floor(seconds / 86400);
+  const hours = Math.floor((seconds % 86400) / 3600);
+  const minutes = Math.floor((seconds % 3600) / 60);
+  if (days > 0) return days + " d " + hours + " h";
+  if (hours > 0) return hours + " h " + minutes + " min";
+  if (minutes > 0) return minutes + " min";
+  return seconds + " s";
+}
+
+// Why the Update button of ONE device can't be used yet (null = it can). The server checks the same things (409), and
+// more (the same version, a downgrade, a withdrawn release); here only what is visible before the button is tapped, like
+// whyDisabled() in DeviceDetails (Module 24). status and update = the LIVE values from the store, not from GET /fleet.
+export function cannotUpdateReason(
+  d: FleetRow,
+  status: DeviceStatus,
+  update: Update | null,
+  otaReady: boolean,
+  hasRelease: boolean,
+): string | null {
+  if (d.key === "revoked") return "This device has been deactivated.";
+  if (d.kind === "node2") return "Node 2 (ESP-NOW) can't be updated over the air: update it by cable.";
+  if (d.kind !== "node1") return "Device kind not known yet: wait for its first message.";
+  if (!otaReady) return "SERVER_URL in the server's .env isn't set: the devices don't know where to download firmware from.";
+  if (!hasRelease) return "No firmware uploaded yet.";
+  if (inProgress(update)) return "The previous update is still running.";
+  if (status !== "online") return "The device isn't online: update commands are only sent to online devices (not queued).";
+  return null;
+}
+
+// The error sentence of a fleet button, or null if the session expired (401, and the refresh failed too: back to the Log in screen).
+// Its message comes from the backend (ApiError), for example "device is offline: update commands are only sent to online devices",
+// or the 503 of Deactivate "not saved in the database yet ... repeat this step in a moment".
+export function errorMessage(err: unknown, fallback: string): string | null {
+  if (err instanceof ApiError && err.code === 401) {
+    handleSessionExpired();
+    return null;
+  }
+  return err instanceof ApiError ? err.message : fallback;
+}
+
+// An error becomes a red toast (4 seconds). Used by Create claim code. The buttons on the device card and the release card use
+// ErrorBox (it stays until Close), because their messages can be long and important.
+export function reportError(err: unknown, fallback: string) {
+  const message = errorMessage(err, fallback);
+  if (message !== null) toast(message, "error");
+}
