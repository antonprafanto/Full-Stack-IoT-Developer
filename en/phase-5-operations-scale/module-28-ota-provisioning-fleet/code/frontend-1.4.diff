--- /dev/null
+++ b/frontend/src/components/ErrorBox.tsx
@@ -0,0 +1,27 @@
+// ErrorBox.tsx - a Fleet screen button's error that does NOT go away by itself (Module 28). A toast disappears after 4 seconds,
+// while an error such as the 503 of Deactivate holds an important, long instruction ("repeat this step in a moment so the database
+// and the broker match again"). This box stays on the card until Close is tapped, or until the same button succeeds.
+type Props = {
+  message: string | null; // null = no error, the box isn't drawn
+  onClose: () => void;
+};
+
+export default function ErrorBox({ message, onClose }: Props) {
+  if (message === null) return null;
+  return (
+    // role="alert": a screen reader reads the error out as soon as the box appears
+    <div
+      role="alert"
+      className="mt-3 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-100"
+    >
+      <p className="break-words">{message}</p>
+      <button
+        type="button"
+        onClick={onClose}
+        className="mt-2 min-h-11 rounded-lg border border-red-400 px-4 hover:bg-red-100 dark:border-red-700 dark:hover:bg-red-900"
+      >
+        Close
+      </button>
+    </div>
+  );
+}
diff --git a/frontend/src/components/FirmwareUpload.tsx b/frontend/src/components/FirmwareUpload.tsx
new file mode 100644
index 0000000..0d39caa
--- /dev/null
+++ b/frontend/src/components/FirmwareUpload.tsx
@@ -0,0 +1,180 @@
+// FirmwareUpload.tsx - the "Upload firmware" form on the Fleet screen (Module 28, admin only). The .bin file from the build folder
+// (Sketch → Export Compiled Binary) is sent AS IT IS to the backend (POST /firmware/node1/<version>); the backend computes its
+// SHA-256 itself, and this screen shows the result so it can be compared with the file's fingerprint on your laptop.
+// The checks in the browser (size, the first byte 0xE9, the file name) are only there to make the error quick and clear: the
+// backend still checks everything again.
+import { useRef, useState } from "react";
+import type { FormEvent } from "react";
+import { ApiError, uploadFirmware } from "../api";
+import { PROGRAM_SHELF, sizeText } from "../fleet";
+import { OtaReport } from "../schemas/contract";
+import { toast } from "../toast";
+import { handleSessionExpired } from "../store";
+import type { Release } from "../types";
+import { wibDateTime } from "../time";
+
+const BOX =
+  "mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100";
+const LABEL = "mt-3 block text-sm font-medium text-slate-700 dark:text-slate-200";
+
+// the SAME version rule as the data contract (x.y.z, for example 1.7.1): the Version schema in schemas/contract.ts, borrowed through
+// OtaReport's version field (that file doesn't export Version itself)
+const Version = OtaReport.shape.version;
+
+// Other files in the build folder that ALSO end in .bin, but aren't app files for OTA
+const NOT_AN_APP = /\.(merged|bootloader|partitions)\.bin$/i;
+
+// Checks a file before it is uploaded. The result is an error sentence, or null if it looks right.
+async function checkFile(file: File): Promise<string | null> {
+  if (!file.name.toLowerCase().endsWith(".bin")) return "Firmware files end in .bin.";
+  if (NOT_AN_APP.test(file.name)) {
+    return "That isn't an app file: choose <sketch>.ino.bin, not .merged.bin, .bootloader.bin, or .partitions.bin.";
+  }
+  if (file.size === 0) return "The file is empty.";
+  if (file.size > PROGRAM_SHELF) {
+    return "Too big: " + file.size.toLocaleString("en-US") + " bytes, one program shelf is only 1,966,080 bytes.";
+  }
+  // the first byte of every ESP32 app file = 0xE9 (233). slice(0, 1) = a 1-byte piece only, without reading the whole file.
+  const first = new Uint8Array(await file.slice(0, 1).arrayBuffer());
+  if (first[0] !== 0xe9) return "Not an ESP32 app file: its first byte must be 0xE9.";
+  return null;
+}
+
+type Props = {
+  onDone: () => void; // a new release saved: the screen fetches the release list and the fleet again
+};
+
+export default function FirmwareUpload({ onDone }: Props) {
+  const [file, setFile] = useState<File | null>(null);
+  const [version, setVersion] = useState("");
+  const [notes, setNotes] = useState("");
+  const [test, setTest] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [result, setResult] = useState<Release | null>(null); // the release just saved (size + sha256 from the server)
+  const fileField = useRef<HTMLInputElement>(null);
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setResult(null);
+    if (file === null) return setError("Choose a .bin file first.");
+    const fileError = await checkFile(file);
+    if (fileError !== null) return setError(fileError);
+    const checkVersion = Version.safeParse(version.trim());
+    if (!checkVersion.success) return setError("Version must look like x.y.z, for example 1.7.1 (the same as FIRMWARE_VERSION).");
+    // backend 1.5 refuses a RELEASE version with a leading zero (1.07.1 equals 1.7.1 as a number, differs as text)
+    if (/(^|\.)0\d/.test(checkVersion.data)) return setError("Version without leading zeros: 1.7.1, not 1.07.1.");
+    if (notes.trim().length > 200) return setError("Notes at most 200 characters.");
+    setBusy(true);
+    try {
+      const release = await uploadFirmware(checkVersion.data, file, notes.trim(), test);
+      setResult(release);
+      toast("Firmware " + release.version + " saved on the server.", "success");
+      // empty the form; the file field can't be emptied through React state, so through its ref
+      setFile(null);
+      setVersion("");
+      setNotes("");
+      setTest(false);
+      if (fileField.current !== null) fileField.current.value = "";
+      onDone();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 401) return handleSessionExpired();
+      // an error from the backend goes in the form (not a toast): it usually needs a slow read, for example "1.7.1 already exists: …"
+      setError(err instanceof ApiError ? err.message : "Upload failed.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form onSubmit={submit} noValidate className="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
+      <h4 className="font-semibold text-slate-800 dark:text-slate-100">Upload Node 1 firmware</h4>
+      <p className="mt-1 text-sm text-slate-600 dark:text-slate-300">
+        Choose <span className="font-mono">&lt;sketch&gt;.ino.bin</span> from the folder <span className="font-mono">build</span> (made by
+        Sketch → Export Compiled Binary). An existing version can't be overwritten: changed firmware always gets a new version.
+      </p>
+
+      <label htmlFor="upload-file" className={LABEL}>
+        .bin file
+      </label>
+      <input
+        ref={fileField}
+        id="upload-file"
+        type="file"
+        accept=".bin"
+        onChange={(e) => setFile(e.target.files?.[0] ?? null)}
+        className="mt-1 block w-full text-sm text-slate-700 file:mr-3 file:min-h-11 file:rounded-lg file:border-0 file:bg-teal-50 file:px-4 file:font-medium file:text-teal-800 hover:file:bg-teal-100 dark:text-slate-200 dark:file:bg-teal-950 dark:file:text-teal-200"
+      />
+      {file !== null ? (
+        <p className="mt-1 text-xs text-slate-600 dark:text-slate-400">
+          {file.name}: {sizeText(file.size)}
+        </p>
+      ) : null}
+
+      <label htmlFor="upload-version" className={LABEL}>
+        Version (the same as FIRMWARE_VERSION in that file)
+      </label>
+      <input
+        id="upload-version"
+        value={version}
+        onChange={(e) => setVersion(e.target.value)}
+        placeholder="1.7.1"
+        inputMode="decimal"
+        autoComplete="off"
+        className={BOX + " sm:w-40"}
+      />
+
+      <label htmlFor="upload-notes" className={LABEL}>
+        Notes (optional)
+      </label>
+      <input
+        id="upload-notes"
+        value={notes}
+        onChange={(e) => setNotes(e.target.value)}
+        maxLength={200}
+        placeholder="for example: a new-version greeting"
+        className={BOX}
+      />
+
+      <label className="mt-3 flex min-h-11 items-start gap-2 text-sm text-slate-700 dark:text-slate-200">
+        <input type="checkbox" checked={test} onChange={(e) => setTest(e.target.checked)} className="mt-0.5 size-5 shrink-0 accent-teal-700" />
+        <span>
+          A <b>test</b> release (for example deliberately broken firmware for rollback practice): can only be sent to one device, never
+          to all, and it doesn't count as the latest release.
+        </span>
+      </label>
+
+      {error !== null ? (
+        // role="alert": a screen reader reads the error out at once
+        <p role="alert" className="mt-3 rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
+          {error}
+        </p>
+      ) : null}
+
+      <button
+        type="submit"
+        disabled={busy}
+        className="mt-3 min-h-11 rounded-lg bg-teal-700 px-4 font-medium text-white hover:bg-teal-800 disabled:opacity-60"
+      >
+        {busy ? "Uploading…" : "Upload firmware"}
+      </button>
+
+      {result !== null ? (
+        <div role="status" className="mt-3 rounded-lg bg-green-50 p-3 text-sm text-green-950 dark:bg-green-950 dark:text-green-100">
+          <p className="font-medium">
+            Saved: Node 1 {result.version}
+            {result.test ? " (test)" : ""}, {wibDateTime(Date.parse(result.created_at))}
+          </p>
+          <p className="mt-1">Size: {sizeText(result.size)}</p>
+          <p className="mt-1">SHA-256 (computed by the server from the file it received):</p>
+          <p className="font-mono text-xs break-all">{result.sha256}</p>
+          <p className="mt-1">
+            Compare it with the file's fingerprint on your laptop (<span className="font-mono">sha256sum</span> or{" "}
+            <span className="font-mono">Get-FileHash</span>): it must match exactly.
+          </p>
+        </div>
+      ) : null}
+    </form>
+  );
+}
diff --git a/frontend/src/components/FleetActions.tsx b/frontend/src/components/FleetActions.tsx
new file mode 100644
index 0000000..ea03b48
--- /dev/null
+++ b/frontend/src/components/FleetActions.tsx
@@ -0,0 +1,259 @@
+// FleetActions.tsx - the admin buttons on a Fleet card (Module 28): Update one device's firmware, the Canary mark, the vitals
+// interval, and Deactivate. Only drawn for admins (FleetCard uses useAdmin), but that's only screen convenience:
+// the backend's guard still answers 403 for a viewer account, and the backend checks every condition again (409).
+import { useEffect, useId, useRef, useState } from "react";
+import type { FormEvent } from "react";
+import { setCanary, setVitalsInterval, deactivate, updateDevice } from "../api";
+import { cannotUpdateReason, errorMessage, sizeText } from "../fleet";
+import { toast } from "../toast";
+import type { FleetRow, Update, FullRelease, DeviceStatus } from "../types";
+import ErrorBox from "./ErrorBox";
+import ConfirmButton from "./ConfirmButton";
+
+const BOX =
+  "mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100";
+
+// the label of a version choice, for example "1.7.1 (latest, in use)" or "1.7.2 (test)"
+function versionLabel(r: FullRelease, latest: string | null, fw: string | null): string {
+  const marks = [r.test ? "test" : "", r.version === latest ? "latest" : "", r.version === fw ? "in use" : ""].filter((t) => t !== "");
+  return r.version + (marks.length > 0 ? " (" + marks.join(", ") + ")" : "");
+}
+
+type Props = {
+  d: FleetRow;
+  status: DeviceStatus; // the LIVE status (store)
+  fw: string | null; // the version that is running (live)
+  update: Update | null; // the last update (live)
+  releases: FullRelease[];
+  latest: string | null;
+  otaReady: boolean;
+  onChange: () => void;
+};
+
+export default function FleetActions({ d, status, fw, update, releases, latest, otaReady, onChange }: Props) {
+  const id = d.device_id;
+  const name = d.name ?? id;
+  const fieldId = useId(); // a unique id for a label + field (one screen holds many cards)
+  // The version choice: the releases that aren't withdrawn, newest on top. The default is the latest release (not a test); a test
+  // release can still be chosen, because it may only be sent through this per-device button anyway.
+  const options = releases.filter((r) => r.withdrawn_at === null).reverse();
+  const defaultVersion = latest ?? options[0]?.version ?? "";
+  // null = the admin hasn't chosen yet: follow the latest release, also after a new release is uploaded. A choice that was withdrawn
+  // (no longer in the list) goes back to the default.
+  const [choice, setChoice] = useState<string | null>(null);
+  const version = choice !== null && options.some((r) => r.version === choice) ? choice : defaultVersion;
+  const chosenRelease = options.find((r) => r.version === version);
+  const [force, setForce] = useState(false); // allow a downgrade
+  const [savingCanary, setSavingCanary] = useState(false);
+  const [seconds, setSeconds] = useState(String(d.vitals_interval_s ?? 300));
+  const [savingInterval, setSavingInterval] = useState(false);
+  const [steps, setSteps] = useState<string[]>([]); // manual work after Deactivate (if any)
+  const [error, setError] = useState<string | null>(null); // the last button error, shown until Close (ErrorBox)
+  const closeSteps = useRef<HTMLButtonElement>(null);
+  // After Deactivate, this card's buttons disappear: the focus moves to the Close of the steps box (also after the card is drawn
+  // again as "deactivated"), so keyboard and screen reader users aren't thrown back to the top of the page.
+  useEffect(() => {
+    if (steps.length > 0) closeSteps.current?.focus();
+  }, [steps, d.key]);
+
+  const fail = (err: unknown, fallback: string) => setError(errorMessage(err, fallback));
+
+  const reason =
+    cannotUpdateReason(d, status, update, otaReady, options.length > 0) ?? (version === fw ? "The device is already running this version." : null);
+
+  // 202 = the device ACCEPTED the command (ack), NOT finished yet. The "accepted the update command" toast comes from the "ota"
+  // event (to every dashboard), so it isn't repeated here; the next steps show by themselves on the card (the "ota" event).
+  async function sendUpdate() {
+    try {
+      const result = await updateDevice(id, version, force);
+      if (result.status === "no-ack") {
+        toast(name + ": command sent, but the device didn't answer within 5 seconds. The result follows when the device reports.");
+      }
+      setForce(false);
+      setError(null);
+      onChange();
+    } catch (err) {
+      fail(err, "The update command couldn't be sent.");
+    }
+  }
+
+  async function changeCanary(value: boolean) {
+    setSavingCanary(true);
+    try {
+      await setCanary(id, value);
+      toast(value ? name + " is now a canary device." : name + " is no longer a canary device.", "success");
+      setError(null);
+      onChange();
+    } catch (err) {
+      fail(err, "The canary mark couldn't be saved.");
+    } finally {
+      setSavingCanary(false);
+    }
+  }
+
+  async function saveVitalsInterval(e: FormEvent) {
+    e.preventDefault(); // don't let the browser reload the page (a form's default behavior)
+    const s = Number(seconds);
+    if (!Number.isInteger(s) || s < 60 || s > 3600) {
+      setError("The vitals interval must be a whole number from 60 to 3600 seconds.");
+      return;
+    }
+    setSavingInterval(true);
+    try {
+      const result = await setVitalsInterval(id, s);
+      // the note is filled in if the device's firmware is still old (it doesn't know the interval yet): saved, applies after an update
+      toast("Vitals interval for " + name + " = " + result.vitals_interval_s + " seconds." + (result.note === null ? "" : " " + result.note), "success");
+      setError(null);
+      onChange();
+    } catch (err) {
+      fail(err, "The vitals interval couldn't be saved.");
+    } finally {
+      setSavingInterval(false);
+    }
+  }
+
+  async function deactivateNow() {
+    try {
+      const result = await deactivate(id);
+      toast(name + " deactivated.", "success");
+      setError(null);
+      setSteps(result.steps); // still shown after the card turns "deactivated"
+      onChange();
+    } catch (err) {
+      // 503 = the database hasn't changed, but a command held up in the bridge can still be carried out by the broker: the
+      // backend's sentence says to REPEAT this step, so the error stays on the card (not a 4-second toast)
+      fail(err, "Couldn't deactivate the device.");
+    }
+  }
+
+  // After deactivating: the buttons are gone, only the manual steps that still need doing remain (if any).
+  const stepsBox =
+    steps.length > 0 ? (
+      <div className="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-950 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-100">
+        <p className="font-medium">After deactivating:</p>
+        <ul className="mt-1 list-disc space-y-1 pl-5 break-words">
+          {steps.map((l) => (
+            <li key={l}>{l}</li>
+          ))}
+        </ul>
+        <button
+          ref={closeSteps}
+          type="button"
+          onClick={() => setSteps([])}
+          className="mt-2 min-h-11 rounded-lg border border-amber-400 px-4 hover:bg-amber-100 dark:border-amber-700 dark:hover:bg-amber-900"
+        >
+          Close
+        </button>
+      </div>
+    ) : null;
+  if (d.key === "revoked") return stepsBox;
+
+  return (
+    <section aria-label={"Admin actions for " + name} className="mt-3 border-t border-slate-200 pt-3 dark:border-slate-700">
+      {d.kind !== "node2" ? (
+        <>
+          {/* one row from 640 px: [version choice] [Update]; the disabled reason and the "are you sure?" box move below it */}
+          <div className="flex flex-wrap items-end gap-x-3 gap-y-2">
+            <div className="w-full sm:w-72">
+              <label htmlFor={fieldId + "-version"} className="block text-sm font-medium text-slate-700 dark:text-slate-200">
+                Update to version
+              </label>
+              <select
+                id={fieldId + "-version"}
+                value={version}
+                onChange={(e) => setChoice(e.target.value)}
+                disabled={options.length === 0}
+                className={BOX}
+              >
+                {options.length === 0 ? <option value="">no release yet</option> : null}
+                {options.map((r) => (
+                  <option key={r.version} value={r.version}>
+                    {versionLabel(r, latest, fw)}
+                  </option>
+                ))}
+              </select>
+            </div>
+            <ConfirmButton
+              wrapper="contents"
+              label="Update"
+              title={"Update " + name + " from " + (fw ?? "?") + " to " + version + "?"}
+              yesLabel="Yes, update"
+              onYes={sendUpdate}
+              disabledReason={reason}
+            >
+              <p>
+                The device accepts the command, stops on purpose, downloads{" "}
+                {chosenRelease === undefined ? "the file" : sizeText(chosenRelease.size)}, then restarts (±1 minute). If
+                the new firmware doesn't connect to the broker within 60 seconds, the device goes back by itself to {fw ?? "its old version"}{" "}
+                (rollback). Don't unplug its power meanwhile.
+              </p>
+              {chosenRelease?.test ? (
+                <p className="mt-1 font-medium">This is a TEST release: made on purpose for rollback practice.</p>
+              ) : null}
+              <label className="mt-2 flex min-h-11 items-center gap-2">
+                <input type="checkbox" checked={force} onChange={(e) => setForce(e.target.checked)} className="size-5 accent-teal-700" />
+                Allow downgrade (if the target version is older)
+              </label>
+            </ConfirmButton>
+          </div>
+          <label className="mt-2 flex min-h-11 items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
+            <input
+              type="checkbox"
+              checked={d.canary}
+              disabled={savingCanary}
+              onChange={(e) => changeCanary(e.target.checked)}
+              className="size-5 accent-violet-700"
+            />
+            Canary: a test device that gets updates first{savingCanary ? " (saving…)" : ""}
+          </label>
+        </>
+      ) : null}
+
+      <details className="mt-1 text-sm">
+        {/* py-3: about 44 px high, easy to tap with a thumb */}
+        <summary className="cursor-pointer py-3 font-medium text-teal-700 dark:text-teal-300">More settings</summary>
+        {d.kind !== "node2" ? (
+          <form onSubmit={saveVitalsInterval} className="flex flex-wrap items-end gap-3">
+            <div>
+              <label htmlFor={fieldId + "-interval"} className="block font-medium text-slate-700 dark:text-slate-200">
+                Vitals interval (seconds, 60-3600)
+              </label>
+              <input
+                id={fieldId + "-interval"}
+                type="number"
+                inputMode="numeric"
+                min={60}
+                max={3600}
+                step={1}
+                value={seconds}
+                onChange={(e) => setSeconds(e.target.value)}
+                className={BOX + " sm:w-32"}
+              />
+            </div>
+            <button
+              type="submit"
+              disabled={savingInterval}
+              className="min-h-11 rounded-lg border border-slate-300 px-4 text-slate-800 hover:bg-slate-50 disabled:opacity-60 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-700"
+            >
+              {savingInterval ? "Saving…" : "Save interval"}
+            </button>
+            <p className="basis-full text-xs text-slate-600 dark:text-slate-400">
+              Only vitals (health). telemetry stays every 10 seconds. Wi-Fi, the server address, and the key can't be changed from afar.
+            </p>
+          </form>
+        ) : null}
+        <div className="mt-3">
+          <ConfirmButton label="Deactivate" title={"Deactivate " + name + "?"} yesLabel="Yes, deactivate" onYes={deactivateNow} danger>
+            <p>
+              For a device that is lost, stolen, or no longer used. Its key is revoked and its broker account deleted: the device
+              is disconnected at once, its messages are ignored, and it can't be updated or controlled. Bringing it back only works with
+              a new key or a new claim code.
+            </p>
+          </ConfirmButton>
+        </div>
+      </details>
+      <ErrorBox message={error} onClose={() => setError(null)} />
+      {stepsBox}
+    </section>
+  );
+}
diff --git a/frontend/src/components/FleetCard.tsx b/frontend/src/components/FleetCard.tsx
new file mode 100644
index 0000000..16d03f2
--- /dev/null
+++ b/frontend/src/components/FleetCard.tsx
@@ -0,0 +1,197 @@
+// FleetCard.tsx - one device on the Fleet screen (Module 28): its firmware version, health from the last vitals (Wi-Fi signal,
+// RAM, uptime, restart reason), its last update, and (admin only) its buttons.
+// Like the cards of the device list (Module 23), every card picks its OWN data from the store: the status, the version from the
+// latest telemetry, and the update notice (the Socket.IO "ota" event) change by themselves without reloading the page.
+import type { ReactNode } from "react";
+import { RESET_MEANINGS, uptimeText, ramText, signalText, UPDATE_TEXT } from "../fleet";
+import { useAdmin, useLiveStore } from "../store";
+import type { FleetRow, Kind, OtaNotice, Update, FullRelease, DeviceStatus } from "../types";
+import { wibDateTime } from "../time";
+import { StatusBadge } from "./Badge";
+import UpdateHistory from "./UpdateHistory";
+import LastSeen from "./LastSeen";
+import FleetActions from "./FleetActions";
+
+const SHAPE = "rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap";
+
+// the thick line on the card's left edge follows the status (like the device list cards)
+const EDGE: Record<DeviceStatus, string> = {
+  online: "border-l-green-500 dark:border-l-green-500",
+  offline: "border-l-red-500 dark:border-l-red-500",
+  "offline-mode": "border-l-sky-400 dark:border-l-sky-400",
+  unknown: "border-l-slate-300 dark:border-l-slate-600",
+};
+
+// The last update = the newest of two sources: the row from GET /fleet, or the live notice from the "ota" event.
+// Both times are UTC in the contract format (2026-10-31T01:02:03Z), so they can be compared as text.
+function latestUpdate(fromServer: Update | null, notice: OtaNotice | undefined): Update | null {
+  if (notice === undefined) return fromServer;
+  // >= : within the same second, the server's row (which is complete) wins over the live notice
+  if (fromServer !== null && fromServer.updated_at >= notice.time) return fromServer;
+  const finishedAt = ["sent", "accepted", "downloading"].includes(notice.status) ? null : notice.time;
+  return {
+    id: notice.id,
+    status: notice.status,
+    from: notice.from,
+    to: notice.to,
+    message: notice.message,
+    created_at: fromServer?.id === notice.id ? fromServer.created_at : notice.time,
+    updated_at: notice.time,
+    finished_at: finishedAt,
+  };
+}
+
+function kindText(kind: Kind, linkedVia: string | null): string {
+  if (kind === "node1") return "Node 1";
+  if (kind === "node2") return "Node 2" + (linkedVia === null ? "" : " via " + linkedVia);
+  return "kind not known yet";
+}
+
+// one "title: content" pair inside the card
+function Field({ title, children }: { title: string; children: ReactNode }) {
+  return (
+    <div className="min-w-0">
+      <dt className="text-xs text-slate-500 dark:text-slate-400">{title}</dt>
+      <dd className="break-words text-slate-800 dark:text-slate-100">{children}</dd>
+    </div>
+  );
+}
+
+type Props = {
+  d: FleetRow; // one row of GET /fleet
+  releases: FullRelease[]; // the release list (for the version choice of the Update button)
+  latest: string | null; // the latest Node 1 release
+  otaReady: boolean; // SERVER_URL is set on the server
+  onChange: () => void; // asks the screen to fetch the fleet data again
+};
+
+export default function FleetCard({ d, releases, latest, otaReady, onChange }: Props) {
+  const id = d.device_id;
+  const admin = useAdmin();
+  const deactivated = d.key === "revoked";
+  // a deactivated device: its live status is ignored (the broker may still keep an old "online", contract 1.6)
+  const liveStatus = useLiveStore((s) => s.status[id]);
+  const status: DeviceStatus = deactivated ? "offline" : (liveStatus ?? d.status);
+  const reading = useLiveStore((s) => s.latest[id]); // the last telemetry (live); undefined = none yet
+  // The firmware version: from telemetry (live, every 10 seconds) ONLY if that telemetry is newer than the fw record in the
+  // database. After a successful update, the database knows the new version first (from the vitals of the device that just
+  // started) before the next telemetry, and the old telemetry in the store still carries the OLD version.
+  const telemetryNewer = reading !== undefined && (d.fw_seen_at === null || Date.parse(reading.ts) >= Date.parse(d.fw_seen_at));
+  const fw = !deactivated && telemetryNewer ? reading.fw : d.fw;
+  // The kind: a device that just registered through a claim code is still "unknown" in GET /fleet until its first message.
+  // As soon as its telemetry arrives, its kind is read from that message (only Node 2 has air pressure), as in
+  // DeviceDetails (Module 24); without this the Update button stays disabled until the page is reloaded.
+  const kind: Kind = d.kind !== "unknown" || reading === undefined ? d.kind : "pressure" in reading ? "node2" : "node1";
+  const row = kind === d.kind ? d : { ...d, kind }; // for FleetActions: the same row with the current kind
+  const lastLive = useLiveStore((s) => s.lastSeen[id]);
+  const last = lastLive ?? (d.last_seen === null ? undefined : Date.parse(d.last_seen));
+  const notice = useLiveStore((s) => s.ota[id]);
+  const update = latestUpdate(d.update, notice);
+  // "needs update" is computed by the server against the fw in the database; a live version equal to the latest release closes it
+  const needsUpdate = d.needs_update && fw !== latest;
+  const h = d.health;
+
+  return (
+    <article
+      aria-labelledby={"fleet-" + id}
+      className={
+        "rounded-xl border border-l-4 border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 " +
+        (deactivated ? "border-l-slate-300 dark:border-l-slate-600" : EDGE[status])
+      }
+    >
+      {/* the title + badges; flex-wrap: on a phone the badges move down a row instead of pushing the name off the screen */}
+      <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+        <h4 id={"fleet-" + id} className="min-w-0 font-semibold break-words text-slate-800 dark:text-slate-100">
+          {d.name ?? id}
+        </h4>
+        {deactivated ? (
+          <span className={SHAPE + " bg-red-600 text-white"}>deactivated</span>
+        ) : (
+          <StatusBadge status={status} />
+        )}
+        {d.canary && !deactivated ? (
+          <span className={SHAPE + " bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-100"}>canary</span>
+        ) : null}
+        {needsUpdate && !deactivated ? (
+          <span className={SHAPE + " bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-100"}>needs update</span>
+        ) : null}
+      </div>
+      <p className="mt-0.5 text-sm text-slate-600 dark:text-slate-400">
+        {kindText(kind, d.linked_via)} · {d.location ?? "no location yet"} · <span className="font-mono text-xs">{id}</span> ·{" "}
+        <LastSeen t={last} kind={kind} checkStale={!deactivated} />
+      </p>
+
+      {/* dl = a "title: content" list. Two columns on a phone, three from 640 px */}
+      <dl className="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
+        <Field title="Firmware version">
+          <span className="font-mono">{fw ?? "—"}</span>
+          {needsUpdate && !deactivated ? <span className="text-slate-600 dark:text-slate-400"> → {latest}</span> : null}
+        </Field>
+        {h === null ? (
+          <Field title="Health">
+            {kind === "node2" ? "Node 2 doesn't send vitals" : "no vitals yet"}
+          </Field>
+        ) : (
+          <>
+            <Field title="Restarted because">
+              {h.reset_reason === null ? (
+                <span className="text-slate-600 dark:text-slate-400">— (the old firmware doesn't report it)</span>
+              ) : (
+                <>
+                  <span className={SHAPE + " " + RESET_MEANINGS[h.reset_reason].color}>{h.reset_reason}</span>{" "}
+                  <span className="text-xs text-slate-600 dark:text-slate-400">{RESET_MEANINGS[h.reset_reason].meaning}</span>
+                </>
+              )}
+            </Field>
+            <Field title="Wi-Fi signal">{signalText(h.rssi)}</Field>
+            <Field title="RAM">{ramText(h.heap_free)}</Field>
+            <Field title="Uptime">{uptimeText(h.uptime_s)}</Field>
+          </>
+        )}
+      </dl>
+      {h !== null ? (
+        <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
+          Health from the last vitals, {wibDateTime(Date.parse(h.ts))}; vitals sent every{" "}
+          {d.vitals_interval_s === null ? "300 seconds (firmware default)" : d.vitals_interval_s + " seconds (set by the admin)"}.
+        </p>
+      ) : null}
+
+      {/* the last update: changes by itself through the "ota" event (accepted -> downloading -> succeeded / rollback / failed).
+          Node 2 is never updated over the air: one sentence is enough */}
+      {kind === "node2" ? (
+        <p className="mt-3 text-sm text-slate-600 dark:text-slate-400">OTA isn't available for Node 2: update it by cable.</p>
+      ) : (
+        <div className="mt-3 text-sm">
+          <span className="text-xs text-slate-500 dark:text-slate-400">Last update: </span>
+          {update === null ? (
+            <span className="text-slate-600 dark:text-slate-400">never over the air</span>
+          ) : (
+            <>
+              <span className={SHAPE + " " + UPDATE_TEXT[update.status].color}>{UPDATE_TEXT[update.status].text}</span>{" "}
+              <span className="font-mono text-slate-800 dark:text-slate-100">
+                {update.from ?? "?"} → {update.to}
+              </span>
+              <span className="text-slate-600 dark:text-slate-400"> · {wibDateTime(Date.parse(update.updated_at))}</span>
+              {update.message !== null ? (
+                <span className="block break-words text-slate-600 dark:text-slate-400">{update.message}</span>
+              ) : null}
+            </>
+          )}
+        </div>
+      )}
+      {deactivated ? (
+        <p className="mt-2 rounded-lg bg-red-50 p-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
+          Deactivated: its key is revoked and its messages are ignored. It comes back only with a new key or a new claim code.
+        </p>
+      ) : null}
+
+      {kind === "node1" ? <UpdateHistory deviceId={id} version={update === null ? "" : update.id + update.status} /> : null}
+
+      {/* the fleet buttons: drawn ONLY when the admin role is certain (the Module 24 pattern). For a device that is already
+          deactivated, FleetActions only shows the manual steps after Deactivate (if any) */}
+      {admin ? (
+        <FleetActions d={row} status={status} fw={fw} update={update} releases={releases} latest={latest} otaReady={otaReady} onChange={onChange} />
+      ) : null}
+    </article>
+  );
+}
