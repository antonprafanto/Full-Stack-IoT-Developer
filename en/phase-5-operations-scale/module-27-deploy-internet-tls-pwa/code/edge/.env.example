# edge/.env.example - the Docker Compose settings of the Mini Smart Home GATEWAY (Raspberry Pi) (Modules 26-27), for compose.edge.yml.
# On the Pi, from the edge folder: cp .env.example .env, fill in the empty lines, then chmod 600 .env. edge/.env isn't in Git.

# The Compose file's name. With this line, "docker compose up -d" in the edge folder is enough (without -f compose.edge.yml).
COMPOSE_FILE=compose.edge.yml

# The CENTRAL broker's address for the HOME bridge (address center:... in bridge/center.conf). Fill it in for where your center is:
#   center on the laptop (Module 26, Kit B)  : the laptop's IP, for example 192.168.1.10 (a fixed address in the router, like
#                                              Module 23's phone mode: if the laptop's IP changes, the bridge breaks)
#   center on the same Pi (Module 27, free path) or the gateway tried on the center laptop: host-gateway (= this machine itself)
#   center on a VPS (Module 27, main path)    : leave it empty. The TLS bridge uses the broker's domain name (mqtt.yourname.my.id)
#                                              written straight in bridge/center.conf, not an address here.
# Empty = host-gateway.
CENTER_ADDRESS=

# The gateway broker's counter. On the Pi: 1883 (the Node 1 firmware uses 1883). The gateway tried on the same laptop as
# compose.cloud.yml (Module 26): 1884, because 1883 is already used by the central broker.
PORT_GATEWAY=1883

# Node-RED in a container (the "nodered" profile, optional; Module 26 keeps using the systemd Node-RED): the editor's counter.
PORT_NODERED=1880

# Profiles that start with "docker compose up -d". Empty = only the gateway broker.
# COMPOSE_PROFILES=nodered

# Module 27: TUNNEL_TOKEN (Cloudflare Tunnel, the free path) is NOT here anymore: write it in the project root .env (compose.cloud.yml).
