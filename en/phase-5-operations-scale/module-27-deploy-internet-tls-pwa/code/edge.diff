diff --git a/edge/center-internet.conf b/edge/center-internet.conf
new file mode 100644
index 0000000..f5af8d2
--- /dev/null
+++ b/edge/center-internet.conf
@@ -0,0 +1,40 @@
+# center-internet.conf - the Mini Smart Home CENTRAL broker on a VPS (Module 27, main path), chosen with CENTER_CONF=
+# center-internet.conf in .env (the mosquitto service in compose.cloud.yml). Its contents are the SAME as center.conf (change both
+# together), plus one more door below: 8883, MQTT encrypted with TLS, for the Pi bridge and devices from the internet. The plain
+# door 1883 is still there for the backend in the Compose hallway, but its counter on the VPS is only 127.0.0.1 (MQTT_ADDRESS), not the internet.
+# Paths below = INSIDE the container.
+# After changing this file or acl-broker: docker compose restart mosquitto (restart, not reload).
+listener 1883
+# without a registered username and password, no one may connect (Module 21)
+allow_anonymous false
+# the password file lives in the broker-data cupboard (made by mosquitto_passwd INSIDE the container; the image hands it to the
+# mosquitto user every time it starts, so there's no file-owner trouble on the laptop)
+password_file /mosquitto/data/broker-passwd
+acl_file /mosquitto/config/acl-broker
+# the client name is always = the username: no one can pretend to be or kick out another client. This option applies PER DOOR
+# (only to the listener above it), so door 8883 below writes it again.
+use_username_as_clientid true
+# retained messages (device statuses, the backend's config) and sessions are kept in the cupboard: not lost when the container is recreated
+persistence true
+persistence_location /mosquitto/data/
+# log to the container's screen: read it with docker compose logs mosquitto (limited to 3 x 10 MB by compose.cloud.yml)
+log_dest stdout
+log_type error
+log_type warning
+log_type notice
+log_type information
+# remove the # in front of the line below to also see the messages REFUSED by the access list (Denied PUBLISH, Module 21);
+# the log gets much busier
+# log_type debug
+# Module 27: the TLS door for visitors from the internet. Its certificate is a COPY of the Let's Encrypt certificate Caddy asked for
+# MQTT_DOMAIN (the mqtt-certificate service copies it to the certificate-data cupboard as owned by the user mosquitto). certfile
+# holds the broker name's certificate + its intermediate issuer's certificate (the chain); keyfile = its key. Without these files,
+# the broker stops when it starts (Unable to load server certificate). The lowest TLS version = Mosquitto 2.x's default, TLS 1.2.
+# The account, password, and access-list rules above apply to this door too; use_username_as_clientid does NOT carry over, so
+# it is written again right under listener 8883. Without that line, ANY broker account (for example the test account checker in
+# MQTTX on a phone) could come in from the internet with the client name "backend" or "pi-bridge": the real client is kicked out
+# (log "session taken over") and the queue of messages the broker holds for the backend is erased too.
+listener 8883
+use_username_as_clientid true
+certfile /mosquitto/certs/broker.crt
+keyfile /mosquitto/certs/broker.key
