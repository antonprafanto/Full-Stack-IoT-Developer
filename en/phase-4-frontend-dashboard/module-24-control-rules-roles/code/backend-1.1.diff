+  it("soil 25: the pump for 5 seconds is sent ONCE, even though the soil stays at 25", async () => {
+    await reading(25);
+    await reading(25);
+    await reading(26);
+    expect(sent).toEqual([{ target: "pump", value: 5 }]);
+    expect(events).toHaveLength(1);
