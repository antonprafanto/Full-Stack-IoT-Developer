# Copy this file to .env, then adjust its contents. The .env file doesn't go into Git (see .gitignore).
MQTT_URL=mqtt://192.168.1.37:1883
# Module 21: the backend's broker account (made on the broker machine with mosquitto_passwd). Make its password with the same
# command as JWT_SECRET below. Don't put a username or password in MQTT_URL.
MQTT_USERNAME=backend
MQTT_PASSWORD=
PORT=8080
HOST=127.0.0.1
# the PostgreSQL database in a Docker container (Module 17); replace change-this-password with a password of your choice
DATABASE_URL=postgres://postgres:change-this-password@127.0.0.1:5432/smarthome
# Telegram (Module 19, optional): the token from @BotFather and your chat_id (the answer to /start). Empty = notifications off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Address of the Bot API server (Module 19). Leave it commented out = the real Telegram server; only filled in for a mock server in the lab.
# TELEGRAM_API_ROOT=
# Module 25: the time of the daily CSV report to Telegram, a 5-field cron (minute hour day month weekday) in WIB: 0 7 * * * = 07:00 WIB
REPORT_SCHEDULE=0 7 * * *
# Level 3 of Module 25: the WEEKLY report (last week, Monday-Sunday WIB), a 5-field cron in WIB. Default: Monday 07:00.
WEEKLY_REPORT_SCHEDULE=0 7 * * 1
# Module 20: the JWT signing key, at least 32 random characters. Make your own with this command, then paste the result:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-this-to-the-output-of-the-command-above
# Module 20: web pages (origins) that may call the API from a browser, comma-separated (Module 22: Vite on port 5173)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
