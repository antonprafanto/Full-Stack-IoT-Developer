+// csv.test.ts - tests for the CSV maker (Module 25, Module 23's recipe on the server): BOM, comma separator, decimal point, CRLF,
+// double quotes, and empty cells. Pure functions: no database, no network. Run: npm test
+import { describe, expect, it } from "vitest";
+import { toCsv, quote } from "./csv.ts";
+
+describe("the CSV maker", () => {
+  it("starts with a BOM (3 bytes EF BB BF), separated by commas, every line ends with CRLF", () => {
+    const text = toCsv([["device_id", "reading_count"], ["f00d00000001", 8640]]);
+    expect(text).toBe("\uFEFFdevice_id,reading_count\r\nf00d00000001,8640\r\n");
+    expect([...Buffer.from(text, "utf8").subarray(0, 3)]).toEqual([0xef, 0xbb, 0xbf]);
+  });
+
+  it("decimal numbers keep their point; negative and whole numbers stay whole", () => {
+    expect(toCsv([[28.8, -69, 0, 184562]])).toBe("\uFEFF28.8,-69,0,184562\r\n");
+  });
+
+  it("null becomes an empty cell (for example Node 2's vitals, which really don't exist)", () => {
+    expect(toCsv([["f00d000000b2", null, null, 3]])).toBe("\uFEFFf00d000000b2,,,3\r\n");
+  });
+
+  it("text containing , \" or a line break is wrapped in quotes, quotes inside are doubled", () => {
+    expect(quote("Node 1, living room")).toBe("\"Node 1, living room\"");
+    expect(quote("Garden \"back\"")).toBe("\"Garden \"\"back\"\"\"");
+    expect(quote("two\r\nlines")).toBe("\"two\r\nlines\"");
+    expect(quote("Garden (mock)")).toBe("Garden (mock)"); // no special characters: as it is
+    expect(toCsv([["a,b", "c"]])).toBe("\uFEFF\"a,b\",c\r\n");
+  });
+});
diff --git b/backend/src/services/csv.ts b/backend/src/services/csv.ts
new file mode 100644
index 0000000..00117ad
--- /dev/null
+++ b/backend/src/services/csv.ts
@@ -0,0 +1,26 @@
+// csv.ts - builds CSV text on the server (Module 25, for the daily report). Its recipe is the SAME as Module 23's frontend/src/csv.ts,
+// so that the file from the dashboard and the one from the Telegram report open just as neatly in Excel or LibreOffice with English
+// (US/UK) regional settings: a comma separator (,), a decimal point (28.5), a BOM at the start of the file, and CRLF at the end of every line.
+// Every function here is "pure": it only turns its input into text, with no database and no network, so it is easy to test.
+
+export type Cell = string | number | null; // the content of one cell: text, a number, or empty
+
+// quote - a value containing , " or a line break is wrapped in double quotes, and the quotes inside are doubled.
+// Example: Node 1, living room  ->  "Node 1, living room"
+export function quote(text: string): string {
+  return /[",\r\n]/.test(text) ? '"' + text.replaceAll('"', '""') + '"' : text;
+}
+
+// one cell: a number keeps its decimal point (28.5), null (failed sensor, missing column, or no data) becomes an empty cell
+function cell(value: Cell): string {
+  if (value === null) return "";
+  if (typeof value === "number") return String(value);
+  return quote(value);
+}
+
+// toCsv - rows (an array of arrays) become one CSV text
+export function toCsv(rows: Cell[][]): string {
+  // "\uFEFF" = BOM: an unseen mark saying the content is UTF-8, so special letters in device names (for example ° or é) stay whole
+  // in Excel. In the file, this BOM becomes 3 bytes: EF BB BF.
+  return "\uFEFF" + rows.map((r) => r.map(cell).join(",")).join("\r\n") + "\r\n";
+}
