# Copy this file to .env, then adjust its contents. The .env file doesn't go into Git (see .gitignore).
# Module 26: this file is only for DEV MODE (npm run dev on the laptop, while changing the backend code). In HOME MODE (Docker
# Compose, the backend service in compose.cloud.yml) the backend does NOT read this file: its settings come from .env at the project root.
# Only one backend may run: before npm run dev, stop the one in the container (docker compose stop backend web).
# Module 26: the CENTRAL broker on this laptop (the mosquitto service of Docker Compose, counter 1883). Node 1's data reaches it through
# the Pi gateway's bridge. Before Module 26: the Pi's IP address, for example mqtt://192.168.1.37:1883.
MQTT_URL=mqtt://127.0.0.1:1883
# Module 21: the backend's broker account. Module 26: the "backend" account on the central broker is made by the broker-account service
# from MQTT_PASSWORD in the root .env, so the password below is the SAME as MQTT_PASSWORD there. Don't put a username or password in MQTT_URL.
MQTT_USERNAME=backend
MQTT_PASSWORD=
PORT=8080
HOST=127.0.0.1
# the PostgreSQL database in a Docker container (Module 17; since Module 26 the db service in compose.cloud.yml, the same counter
# 127.0.0.1:5432). Replace change-this-password with your postgres password (= POSTGRES_PASSWORD in the root .env).
DATABASE_URL=postgres://postgres:change-this-password@127.0.0.1:5432/smarthome
# Telegram (Module 19, optional): the token from @BotFather and your chat_id (the answer to /start). Empty = notifications off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Address of the Bot API server (Module 19). Leave it commented out = the real Telegram server; only filled in for a mock server in the lab.
# TELEGRAM_API_ROOT=
# Module 25: the time of the daily CSV report to Telegram, a 5-field cron (minute hour day month weekday) in WIB: 0 7 * * * = 07:00 WIB
REPORT_SCHEDULE=0 7 * * *
# Module 20: the JWT signing key, at least 32 random characters. Make your own with this command, then paste the result:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-this-to-the-output-of-the-command-above
# Module 20: web pages (origins) that may call the API from a browser, comma-separated (Module 22: Vite on port 5173).
# Its form is http(s)://name[:port] without a / at the end (Module 27 checks it when the server starts).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Module 27: the proxy trusted to tell the visitor's IP address and protocol (X-Forwarded-For/-Proto). Dev mode without
# Caddy: leave it empty. The backend in Docker Compose behind Caddy uses uniquelocal from compose.cloud.yml, not from
# this file. A number (a hop count) is refused: Fastify 5 doesn't trust it.
TRUST_PROXY=
# Module 28: the server address for DEVICES: the firmware download url in an update command = SERVER_URL + /fw/node-1/<version>.bin.
# Empty = over-the-air updates off. Dev mode with the tools/ simulator on the same laptop: http://127.0.0.1:8080 (this backend
# only listens on 127.0.0.1, so a real ESP32 can't download from it), and the SAME SERVER_URL in tools/.env
# (a device only downloads from the server address stored on it). A claim (POST /api/provision/claim) needs the /api prefix
# from Caddy: in dev mode register a fake device with POST /devices. http:// only for a home IP address (10.x,
# 172.16-31.x, 192.168.x) or 127.x: the device key is sent along. Home and internet modes: the root .env, not here.
SERVER_URL=
# Module 28: are device broker accounts created/deleted automatically through dynamic security? off (default, like Module 21), center
# (the broker on this laptop), or gateway:<gateway name>, for example gateway:pi1 (through the bridge to the Pi gateway's broker).
AUTO_BROKER_ACCOUNTS=off
# Module 28: the folder of uploaded firmware files (relative to the backend folder; not in Git). Leave the default.
# FIRMWARE_DIR=firmware-data
# Module 28: an update without word for this many minutes is marked expired (default 10). Leave the default.
# OTA_TIMEOUT_MINUTES=10
