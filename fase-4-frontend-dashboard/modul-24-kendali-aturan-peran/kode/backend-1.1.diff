+  it("jadwal dengan aksi sakelar tetap ditolak: jadwal tidak punya saat padam", () => {
+    const hasil = Aturan.safeParse({ ...siramTanah, kondisi: { jenis: "jadwal", cron: "0 6 * * *" },
