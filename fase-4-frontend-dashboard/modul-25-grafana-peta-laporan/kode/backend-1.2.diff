+async function bacaSetelan(jadwal: string) {
+  vi.resetModules();
+  for (const [nama, nilai] of Object.entries({ ...SAH, LAPORAN_JADWAL: jadwal })) vi.stubEnv(nama, nilai);
+  return (await import("./env.ts")).env;
+}
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
