# Salin file ini menjadi .env, lalu sesuaikan isinya. File .env tidak ikut Git (lihat .gitignore).
MQTT_URL=mqtt://192.168.1.37:1883
# Modul 21: akun broker milik backend (dibuat di mesin broker dengan mosquitto_passwd). Buat sandinya dengan perintah yang
# sama dengan JWT_SECRET di bawah. Jangan menaruh nama pengguna atau sandi di MQTT_URL.
MQTT_USERNAME=backend
MQTT_PASSWORD=
PORT=8080
HOST=127.0.0.1
# database PostgreSQL di kontainer Docker (Modul 17); ganti ganti-sandi-ini dengan sandi pilihanmu
DATABASE_URL=postgres://postgres:ganti-sandi-ini@127.0.0.1:5432/rumahpintar
# Telegram (Modul 19, tidak wajib): token dari @BotFather dan chat_id-mu (balasan /start). Kosong = notifikasi mati.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alamat server Bot API (Modul 19). Biarkan berkomentar = server Telegram sungguhan; hanya diisi untuk server tiruan di lab.
# TELEGRAM_API_ROOT=
# Modul 25: jam laporan harian CSV ke Telegram, cron 5 bidang (menit jam tanggal bulan hari) dalam WIB: 0 7 * * * = 07.00 WIB
LAPORAN_JADWAL=0 7 * * *
# Tantangan 3 Modul 25: laporan MINGGUAN (minggu lalu, Senin-Minggu WIB), cron 5 bidang WIB. Bawaan Senin 07.00.
LAPORAN_MINGGUAN_JADWAL=0 7 * * 1
# Modul 20: kunci tanda tangan JWT, minimal 32 karakter acak. Buat sendiri dengan perintah ini, lalu tempel hasilnya:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=ganti-dengan-hasil-perintah-di-atas
# Modul 20: halaman web (origin) yang boleh memanggil API dari browser, dipisah koma (Modul 22: Vite di port 5173)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
