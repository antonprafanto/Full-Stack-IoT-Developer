{
  "name": "rumah-pintar-mini-backend",
  "version": "2.0.0",
  "description": "Backend Rumah Pintar Mini (Modul 16-21): mendengar MQTT, memeriksa kontrak data, menyimpan semua pesan ke database deret waktu, menyediakan API riwayat, data realtime, perintah, aturan otomatis, jadwal, dan notifikasi Telegram, login dengan peran admin dan viewer, daftar resmi perangkat dengan kunci per perangkat dan akun broker tersendiri, serta (Modul 28) pembaruan firmware lewat udara, kode klaim, dan data armada",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "cek": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "migrasi": "node --env-file-if-exists=.env src/db/migrasi.ts",
    "isi-riwayat": "node --env-file-if-exists=.env src/db/isi-riwayat.ts",
    "pengguna": "node --env-file-if-exists=.env src/db/kelola-pengguna.ts",
    "test": "vitest run",
    "test:integrasi": "vitest run src/integrasi"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "grammy": "^1.46.0",
    "mqtt": "^5.16.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
