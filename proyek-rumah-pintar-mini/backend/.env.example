# Salin file ini menjadi .env, lalu sesuaikan isinya. File .env tidak ikut Git (lihat .gitignore).
# Modul 26: berkas ini hanya untuk MODE KEMBANG (npm run dev di laptop, saat mengubah kode backend). Di MODE RUMAH (Docker
# Compose, layanan backend di compose.cloud.yml) backend TIDAK membaca berkas ini: setelannya datang dari .env di akar proyek.
# Satu backend saja yang boleh menyala: sebelum npm run dev, hentikan yang di kontainer (docker compose stop backend web).
# Modul 26: broker PUSAT di laptop ini (layanan mosquitto Docker Compose, loket 1883). Data Node 1 sampai ke sini lewat
# jembatan gerbang Pi. Sebelum Modul 26: alamat IP Pi, misalnya mqtt://192.168.1.37:1883.
MQTT_URL=mqtt://127.0.0.1:1883
# Modul 21: akun broker milik backend. Modul 26: akun "backend" di broker pusat dibuat layanan akun-broker dari MQTT_PASSWORD
# di .env akar, jadi sandi di bawah SAMA dengan MQTT_PASSWORD di .env akar. Jangan menaruh nama pengguna atau sandi di MQTT_URL.
MQTT_USERNAME=backend
MQTT_PASSWORD=
PORT=8080
HOST=127.0.0.1
# database PostgreSQL di kontainer Docker (Modul 17; sejak Modul 26 layanan db di compose.cloud.yml, loket 127.0.0.1:5432 yang
# sama). Ganti ganti-sandi-ini dengan sandi postgres-mu (= POSTGRES_PASSWORD di .env akar).
DATABASE_URL=postgres://postgres:ganti-sandi-ini@127.0.0.1:5432/rumahpintar
# Telegram (Modul 19, tidak wajib): token dari @BotFather dan chat_id-mu (balasan /start). Kosong = notifikasi mati.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alamat server Bot API (Modul 19). Biarkan berkomentar = server Telegram sungguhan; hanya diisi untuk server tiruan di lab.
# TELEGRAM_API_ROOT=
# Modul 25: jam laporan harian CSV ke Telegram, cron 5 bidang (menit jam tanggal bulan hari) dalam WIB: 0 7 * * * = 07.00 WIB
LAPORAN_JADWAL=0 7 * * *
# Modul 20: kunci tanda tangan JWT, minimal 32 karakter acak. Buat sendiri dengan perintah ini, lalu tempel hasilnya:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=ganti-dengan-hasil-perintah-di-atas
# Modul 20: halaman web (origin) yang boleh memanggil API dari browser, dipisah koma (Modul 22: Vite di port 5173).
# Bentuknya http(s)://nama[:port] tanpa / di akhir (Modul 27 memeriksanya saat server menyala).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Modul 27: penerus (proxy) yang dipercaya memberi tahu alamat IP dan protokol tamu (X-Forwarded-For/-Proto). Mode kembang
# tanpa Caddy: biarkan kosong. Backend di Docker Compose di balik Caddy memakai uniquelocal dari compose.cloud.yml, bukan
# dari berkas ini. Angka (jumlah hop) ditolak: Fastify 5 tidak memercayainya.
TRUST_PROXY=
# Modul 28: alamat server untuk PERANGKAT: url unduh firmware di perintah update = ALAMAT_SERVER + /fw/node-1/<versi>.bin.
# Kosong = pembaruan lewat udara mati. Mode kembang dengan simulator alat/ di laptop yang sama: http://127.0.0.1:8080 (backend
# ini hanya mendengar 127.0.0.1, jadi ESP32 sungguhan tidak bisa mengunduh darinya), dan ALAMAT_SERVER yang SAMA di alat/.env
# (perangkat hanya mengunduh dari alamat server yang tersimpan padanya). Klaim (POST /api/provision/klaim) butuh awalan /api
# dari Caddy: di mode kembang daftarkan perangkat palsu dengan POST /devices. http:// hanya untuk alamat IP rumah (10.x,
# 172.16-31.x, 192.168.x) atau 127.x: kunci perangkat ikut terkirim. Mode rumah dan internet: .env akar, bukan di sini.
ALAMAT_SERVER=
# Modul 28: akun broker perangkat dibuat/dihapus otomatis lewat dynamic security? mati (bawaan, seperti Modul 21), pusat
# (broker di laptop ini), atau gerbang:<nama gerbang>, misalnya gerbang:pi1 (lewat jembatan ke broker gerbang Pi).
AKUN_BROKER_OTOMATIS=mati
# Modul 28: folder berkas firmware yang diunggah (relatif dari folder backend; tidak ikut Git). Biarkan bawaan.
# FIRMWARE_DIR=data-firmware
# Modul 28: pembaruan tanpa kabar sekian menit ditandai kedaluwarsa (bawaan 10). Biarkan bawaan.
# OTA_BATAS_MENIT=10
